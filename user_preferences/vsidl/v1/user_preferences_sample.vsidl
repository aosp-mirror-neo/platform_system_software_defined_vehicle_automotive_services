package: "com.android.sdv.sample.user_preferences"

service_bundle {
    name: "UserPreferencesServiceBundle"
    server {
        service: "com.android.sdv.user_preferences.UserPreferencesAdminService"
    }
    server {
        service: "com.android.sdv.user_preferences.UserPreferencesManagementService"
    }
    server {
        service: "com.android.sdv.user_preferences.UserPreferencesRegistryService"
    }
    client {
        service: "com.android.sdv.user_preferences.view.ChangeNotifier"
    }
    client {
        service: "com.android.sdv.user_preferences.user_controllable.UserControllableService"
    }
}

service_bundle {
    name: "HMIService"
    server {
        service: "com.android.sdv.user_preferences.view.ChangeNotifier"
    }
    client {
        service: "com.android.sdv.user_preferences.UserPreferencesManagementService"
    }
    client {
        service:  "com.android.sdv.user_preferences.UserPreferencesAdminService"
    }
}

service_bundle {
    name: "HVACService"
    server {
        service: "com.android.sdv.user_preferences.user_controllable.UserControllableService"
    }
    client {
        service: "com.android.sdv.user_preferences.UserPreferencesRegistryService"
    }
}

service_bundle {
    name: "CarSeatsService"
    server {
        service: "com.android.sdv.user_preferences.user_controllable.UserControllableService"
    }
    client {
        service: "com.android.sdv.user_preferences.UserPreferencesRegistryService"
    }
}