# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.user_preferences"

sdv_service_bundle {
    name: "UserPreferencesServiceBundle"

    unit_type {
        access_modifier: PUBLIC
        type: "UserPreferencesAdminService"
    }
    unit_type {
        access_modifier: PUBLIC
        type: "UserPreferencesManagementService"
    }
    unit_type {
        access_modifier: PUBLIC
        type: "UserPreferencesRegistryService"
    }
    unit_type {
        access_modifier: PUBLIC
        type: "view.ChangeNotifier"
    }
    unit_type {
        access_modifier: PUBLIC
        type: "user_controllable.UserControllableService"
    }

    server {
        interface: "sdv.user_preferences.UserPreferencesAdminService"
        acl: "user-preferences-admin-service-clients"
    }
    server {
        interface: "sdv.user_preferences.UserPreferencesManagementService"
        acl: "user-preferences-setting-management-service-clients"
    }
    server {
        interface: "sdv.user_preferences.UserPreferencesRegistryService"
        acl: "user-preferences-registry-service-clients"
    }
    client {
        interface: "sdv.user_preferences.view.ChangeNotifier"
    }
    client {
        interface: "sdv.user_preferences.user_controllable.UserControllableService"
    }
}

sdv_service_bundle {
    name: "HMIService"
    server {
        interface: "sdv.user_preferences.view.ChangeNotifier"
        acl: "hmi-change-notifier-service-clients"
    }
    client {
        interface: "sdv.user_preferences.UserPreferencesManagementService"
    }
    client {
        interface:  "sdv.user_preferences.UserPreferencesAdminService"
    }
}

sdv_service_bundle {
    name: "HVACService"
    server {
        interface: "sdv.user_preferences.user_controllable.UserControllableService"
        acl: "hvac-user-controllable-service-clients"
    }
    client {
        interface: "sdv.user_preferences.UserPreferencesRegistryService"
    }
}