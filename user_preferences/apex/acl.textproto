# proto-file:
# //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/authz_policy.proto
# proto-message: AuthzPolicy

# ACL policies for User Preferences Unit Types.

acls {
  name: "Internal"
  include: "com.android.sdv.user_preferences.UserPreferencesServiceBundle"
  include: "com.android.sdv.sample.user_preferences.UserPreferencesServiceBundle"
}

acls {
  name: "Public"
  include: "com.android.sdv.sample.user_preferences.*"
  include: "com.android.testapp.sdvcarmonitor.SdvCarMonitorTestApp"
}

unit_types { name: "UserPreferencesAdminService" acl_names: "Internal" }

unit_types { name: "UserPreferencesManagementService" acl_names: "Internal" }

unit_types { name: "UserPreferencesRegistryService" acl_names: "Internal" }

unit_types { name: "user_controllable.UserControllableService" acl_names: "Public" }

unit_types { name: "view.ChangeNotifier" acl_names: "Public" }

# Permissions

server {
  service: "com.android.sdv.user_preferences.UserPreferencesManagementService"
  channel: "com-android-sdv-user-preferences-user-preferences-management-service"
}
