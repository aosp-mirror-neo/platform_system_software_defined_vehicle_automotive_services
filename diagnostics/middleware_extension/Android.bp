// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "sdv_middleware_extension_diagnostics@rust_defaults",
    srcs: ["src/lib.rs"],
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "libsdvmiddleware_rpc",
        "libprotobuf",
        "libparking_lot",
        "libdiagnostics_api",
    ],
    edition: "2021",
    lints: "android",
    clippy_lints: "android",
}

rust_library {
    name: "libsdv_middleware_extension_diagnostics",
    crate_name: "sdv_middleware_extension_diagnostics",
    defaults: [
        "sdv_middleware_extension_diagnostics@rust_defaults",
    ],
    vendor_available: true,
}

rust_test {
    name: "sdv_middleware_extension_diagnostics_tests",
    crate_name: "sdv_middleware_extension_diagnostics_tests",
    defaults: [
        "sdv_middleware_extension_diagnostics@rust_defaults",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
