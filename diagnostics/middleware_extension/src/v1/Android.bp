package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_mw_rs_diag@rust_defaults",
    srcs: ["lib.rs"],
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "libprotobuf",
        "libparking_lot",
        "libdiagnostics_v1_api",
        "libvsidl_v1_stdlib_proto_rs",
        "libsdv_mw_rs_comms",
        "libsdv_status_rs",
        "libsdv_proto_reflection_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    edition: "2021",
    lints: "android",
    clippy_lints: "android",
}

rust_library {
    name: "libsdv_mw_rs_diag",
    crate_name: "sdv_mw_rs_diag",
    defaults: [
        "sdv_mw_rs_diag@rust_defaults",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_mw_rs_diag_tests",
    crate_name: "sdv_mw_rs_diag_tests",
    defaults: [
        "sdv_mw_rs_diag@rust_defaults",
    ],
    test_options: {
        unit_test: true,
    },
    rustlibs: [
        "libsdv_mw_local_comms",
        "libgoogletest_rust",
        "libtokio",
        "libsdv_comms_rs",
        "libsdv_mw_rs_sdv_comms",
        "libfutures_util",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_config_template: ":sdv_authz_enforcement_flag_permissions_only_config_template",
    require_root: true,
}
