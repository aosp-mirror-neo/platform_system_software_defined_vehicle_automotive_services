package android.sdv.diagnostics;

/**
 * Negative response codes for diagnostic requests.
 *
 * See ISO 14229-1:2020, table A.1.
 */
@SuppressWarnings({"redundant-name"})
@Backing(type="byte")
enum ResponseCode {
    // 0x00 (POSITIVE_RESPONSE): Reserved for server internal implementation.

    // 0x01 to 0x0F: Reserved.

    GENERAL_REJECT = 0x10u8,
    SERVICE_NOT_SUPPORTED = 0x11u8,
    SUB_FUNCTION_NOT_SUPPORTED = 0x12u8,
    INCORRECT_MESSAGE_LENGTH_OR_INVALID_FORMAT = 0x13u8,
    RESPONSE_TOO_LONG = 0x14u8,

    // 0x15 to 0x20: Reserved.

    BUSY_REPEAT_REQUEST = 0x21u8,
    CONDITIONS_NOT_CORRECT = 0x22u8,

    // 0x23: Reserved.

    REQUEST_SEQUENCE_ERROR = 0x24u8,
    NO_RESPONSE_FROM_SUBNET_COMPONENT = 0x25u8,
    FAILURE_PREVENTS_EXECUTION_OF_REQUESTED_ACTION = 0x26u8,

    // 0x27 to 0x30: Reserved.

    REQUEST_OUT_OF_RANGE = 0x31u8,

    // 0x32: Reserved.

    SECURITY_ACCESS_DENIED = 0x33u8,
    AUTHENTICATION_REQUIRED = 0x34u8,
    INVALID_KEY = 0x35u8,
    EXCEEDED_NUMBER_OF_ATTEMPTS = 0x36u8,
    REQUIRED_TIME_DELAY_NOT_EXPIRED = 0x37u8,
    SECURE_DATA_TRANSMISSION_REQUIRED = 0x38u8,
    SECURE_DATA_TRANSMISSION_NOT_ALLOWED = 0x39u8,
    SECURE_DATA_VERIFICATION_FAILED = 0x40u8,

    // 0x3B to 0x4F: Reserved.

    CERTIFICATE_VERIFICATION_FAILED_INVALID_TIME_PERIOD = 0x50u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_SIGNATURE = 0x51u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_CHAIN_OF_TRUST = 0x52u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_TYPE = 0x53u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_FORMAT = 0x54u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_CONTENT = 0x55u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_SCOPE = 0x56u8,
    CERTIFICATE_VERIFICATION_FAILED_INVALID_CERTIFICATE = 0x57u8,
    OWNERSHIP_VERIFICATION_FAILED = 0x58u8,
    CHALLENGE_CALCULATION_FAILED = 0x59u8,
    SETTING_ACCESS_RIGHTS_FAILED = 0x5Au8,
    SESSION_KEY_CREATION_FAILED = 0x5Bu8,
    CONFIGURATION_DATA_USAGE_FAILED = 0x5Cu8,
    DEAUTHENTICATION_FAILED = 0x5Du8,

    // 0x5E to 0x6F: Reserved.

    UPLOAD_DOWNLOAD_NOT_ACCEPTED = 0x70u8,
    TRANSFER_DATA_SUSPENDED = 0x71u8,
    GENERAL_PROGRAMMING_FAILURE = 0x72u8,
    WRONG_BLOCK_SEQUENCE_COUNTER = 0x73u8,

    // 0x74 to 0x77: Reserved.

    REQUEST_CORRECTLY_RECEIVED_RESPONSE_PENDING = 0x78u8,

    // 0x79 to 0x7D: Reserved.

    SUB_FUNCTION_NOT_SUPPORTED_IN_ACTIVE_SESSION = 0x7Eu8,
}
