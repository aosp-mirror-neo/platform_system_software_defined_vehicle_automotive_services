package android.sdv.diagnostics.security_access;

/**
 * Handler for the SecurityAccess (UDS 0x27) service.
 *
 * Provides means to access data and/or diagnostics services, which have restricted access
 * for security.
 *
 * Typical use of the service is as follows:
 * - client requests the "seed" from the server.
 * - client sends the "key" corresponding to the received "seed".
 * - server validates the "key" and unlocks itself.
 *
 * See ISO 14229-1:2020 section 10.4.
 */
interface ISecurityAccessHandler {
    /**
     * Requests seed corresponding to the securityAccessType.
     *
     * @param[in] securityAccessType security access type for which the seed is requested.
     *            Value from 0x01 to 0x21, corresponding to SubFunction values 0x01, 0x03,
     *            ..., 0x41, as defined in ISO 14229-1:2020, section 10.4.2.2.
     * @param[in] securityAccessDataRecord additional optional data sent to the server
     *            while requesting the seed.
     *
     * @return seed value, to be used by the client when calculating the key needed to
     *         access security.
     */
    byte[] requestSeed(in byte securityAccessType, in byte[] securityAccessDataRecord);

    /**
     * Sends key to unlock the service.
     *
     * @param[in] securityAccessType security access type for which the key is sent.
     *            Value from 0x01 to 0x21, corresponding to SubFunction values 0x02, 0x04,
     *            ..., 0x42, as defined in ISO 14229-1:2020, section 10.4.2.2.
     * @param[in] key the value generated by the security algorithm corresponding to a
     *            specific seed value
     */
    void sendKey(in byte securityAccessType, in byte[] key);
}
