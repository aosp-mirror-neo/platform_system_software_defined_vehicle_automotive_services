package android.sdv.diagnostics.authentication;

/**
 * Return value for `IAuthenticationHandler#verifyCertificateBidirectional`.
 */
parcelable VerifyCertificateBidirectionalResponse {
    /**
     * See `IAuthenticationResponse`.
     */
    byte authenticationResponse;

    /**
     * The challenge contains vehicle manufacturer specific formatted server data or is a
     * random number.
     *
     * Format of this field is OEM-specific.
     */
    byte[] challenge;

    /**
     * A certificate to verify.
     *
     * Format of this field is OEM-specific.
     */
    byte[] certificate;

    /**
     * Proof of ownership to be verified by the client.
     *
     * Format of this field is OEM-specific.
     */
    byte[] proofOfOwnership;

    /**
     * Ephemeral public key generated by the server for Diffie-Hellman key agreement.
     *
     * Non-null only when using Diffie-Hellman key agreement for secure diagnostic
     * communication.
     */
    @nullable byte[] ephemeralPublicKey;
}
