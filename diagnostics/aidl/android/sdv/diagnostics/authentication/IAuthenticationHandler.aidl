package android.sdv.diagnostics.authentication;

import android.sdv.diagnostics.authentication.ProofOfOwnershipResponse;
import android.sdv.diagnostics.authentication.RequestChallengeResponse;
import android.sdv.diagnostics.authentication.VerifyCertificateBidirectionalResponse;
import android.sdv.diagnostics.authentication.VerifyCertificateResponse;
import android.sdv.diagnostics.authentication.VerifyProofOfOwnershipBidirectionalResponse;
import android.sdv.diagnostics.authentication.VerifyProofOfOwnershipResponse;

/**
 * Handler for Authentication (UDS 0x29) service.
 *
 * See ISO 14229-1:2020, section 10.6.
 */
interface IAuthenticationHandler {
    /**
     * Request to leave to authenticated state.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @return see `IAuthenticationResponse`.
     */
    byte deAuthenticate(in int connectionId);

    /**
     * Initiate Authentication by verifying the certificate.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] certificate the certificate to verify.
     *            Format of this parameter is OEM-specific.
     * @param[in] challenge contains formatted client data or is a random number. Null if
     *            not needed for Proof of Ownership verification.
     *            Format of this parameter is OEM-specific.
     * @return see `VerifyCertificateResponse`.
     */
    VerifyCertificateResponse verifyCertificate(
            in int connectionId, in byte[] certificate, in @nullable byte[] challenge);

    /**
     * Initiate Authentication by verifying the certificate and generating a Proof of
     * Ownership from the server.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] certificate the certificate to verify.
     *            Format of this parameter is OEM-specific.
     * @param[in] challenge contains formatted client data or is a random number.
     *            Format of this parameter is OEM-specific.
     * @return see `VerifyCertificateResponse`.
     */
    VerifyCertificateBidirectionalResponse verifyCertificateBidirectional(
            in int connectionId, in byte[] certificate, in byte[] challenge);

    /**
     * Verify the Proof of Ownership from the client.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] proofOfOwnership proof of ownership of the previous given
     *            challenge to be verified by the server.
     * @param[in] ephemeralPublicKey key generated by the client for Diffie-Hellman key
     *            agreement. Non-null only when using Diffie-Hellman key agreement for
     *            secure diagnostic communication.
     * @return see `ProofOfOwnershipResponse`.
     */
    ProofOfOwnershipResponse proofOfOwnership(in int connectionId, in byte[] proofOfOwnership,
            in @nullable byte[] ephemeralPublicKey);

    /**
     * Transfer the certificate for further processing.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] certificateEvaluationId a unique id to identify the evaluation type of
     *            the transmitted certificate.
     * @param[in] certificateData the certificate to verify.
     *            Format of this parameter is OEM-specific.
     * @return see `IAuthenticationResponse`.
     */
    byte transmitCertificate(
            in int connectionId, in byte certificateEvaluationId, in byte[] certificateData);

    /**
     * Initiate the Authentication process by requesting server to output a challenge
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] communicationConfiguration configuration information about how to
     *            proceed with security in further diagnostic communication after the
     *            Authentication.
     * @param[in] algorithmIndicator indicates the algorithm used in the generating and
     *            verifying proof of ownership.
     *            Format of this parameter is OEM-specific.
     * @return see `RequestChallengeResponse`.
     */
    RequestChallengeResponse requestChallengeForAuthentication(
            in int connectionId, in byte communicationConfiguration, in byte[] algorithmIndicator);

    /**
     * Request server to verify the client side Proof of Ownership for unidirectional
     * authentication.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] algorithmIndicator indicates the algorithm used in the generating and
     *            verifying proof of ownership.
     *            Format of this parameter is OEM-specific.
     * @param[in] proofOfOwnership proof of ownership of the previous given challenge to
     *            be verified by the server.
     *            Format of this parameter is OEM-specific.
     * @param[in] challenge contains vehicle manufacturer specific formatted client data
     *            or is a random number. Null if not needed for Proof of Ownership
     *            verification.
     *            Format of this parameter is OEM-specific.
     * @param[in] additionalParameter additional parameter provided to the server if the
     *            server indicates the need for such parameter in
     *            `RequestChallengeResponse`.
     *            Format of this parameter is OEM-specific.
     * @return see `VerifyProofOfOwnershipResponse`.
     */
    VerifyProofOfOwnershipResponse verifyProofOfOwnership(in int connectionId,
            in byte[] algorithmIndicator, in byte[] proofOfOwnership,
            in @nullable byte[] challenge, in @nullable byte[] additionalParameter);

    /**
     * Request server to verify the client side Proof of Ownership and provide server-side
     * Proof of Ownership for bidirectional authentication.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @param[in] algorithmIndicator indicates the algorithm used in the generating and
     *            verifying proof of ownership.
     *            Format of this parameter is OEM-specific.
     * @param[in] proofOfOwnership proof of ownership of the previous given
     *            challenge to be verified by the server.
     *            Format of this parameter is OEM-specific.
     * @param[in] challenge contains vehicle manufacturer specific formatted client
     *            data or is a random number.
     *            Format of this parameter is OEM-specific.
     * @param[in] additionalParameter additional parameter provided to the server if the
     *            server indicates the need for such parameter in
     *            `RequestChallengeResponse`.
     *            Format of this parameter is OEM-specific.
     * @return see `VerifyProofOfOwnershipResponse`.
     */
    VerifyProofOfOwnershipBidirectionalResponse verifyProofOfOwnershipBidirectional(
            in int connectionId, in byte[] algorithmIndicator, in byte[] proofOfOwnership,
            in byte[] challenge, in @nullable byte[] additionalParameter);

    /**
     * Indicates the provided authentication configuration of the server.
     *
     * @param[in] connectionId see `DiagnosticsManagerPlatform#getConnectionMetadata`.
     * @return see `IAuthenticationResponse`.
     */
    byte authenticationConfiguration(in int connectionId);
}
