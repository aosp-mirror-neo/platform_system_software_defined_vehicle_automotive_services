package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_uds_comms@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        // keep-sorted start
        "libautomotive_diag",
        "libbytes",
        "libdoip_definitions",
        "libfutures",
        "liblog_rust",
        "libthiserror",
        "libtokio",
        "libtokio_util",
        "libtower",
        // keep-sorted end
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    edition: "2021",
    lints: "android",
}

rust_library {
    name: "libsdv_uds_comms",
    crate_name: "sdv_uds_comms",
    defaults: [
        "sdv_uds_comms@rust_defaults",
    ],
    srcs: ["src/lib.rs"],
    product_available: true,
    vendor_available: true,
    host_supported: true,
}

rust_test {
    name: "sdv_uds_comms_tests",
    defaults: [
        "sdv_uds_comms@rust_defaults",
    ],
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libgoogletest_rust",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}

rust_test {
    name: "sdv_uds_comms_integration_tests",
    defaults: [
        "sdv_uds_comms@rust_defaults",
    ],
    srcs: [
        "tests/doip_integration.rs",
    ],
    rustlibs: [
        "libsdv_uds_comms",
    ],
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
