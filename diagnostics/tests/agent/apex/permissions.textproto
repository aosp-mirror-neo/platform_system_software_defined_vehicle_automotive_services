server { service: "com.android.sdv.diagnostics.DiagnosticsManagerService" allow_all_channels: true }

client { service: "com.android.sdv.diagnostics.data_item.DataItemService" allow_all_channels: true }

client {
  service: "com.android.sdv.diagnostics.routine_control.RoutineControlService"
  allow_all_channels: true
}

client {
  service: "com.android.sdv.diagnostics.io_control.IoControlService"
  allow_all_channels: true
}

client {
  service: "com.android.sdv.diagnostics.fault.FaultListenerService"
  allow_all_channels: true
}

client { service: "com.android.sdv.diagnostics.ecu_reset.EcuResetService" allow_all_channels: true }

client {
  service: "com.android.sdv.diagnostics.security_access.SecurityAccessService"
  allow_all_channels: true
}

client {
  service: "com.android.sdv.diagnostics.authentication.AuthenticationService"
  allow_all_channels: true
}

client {
  service: "com.android.sdv.diagnostics.file_transfer.FileTransferService"
  allow_all_channels: true
}

subscriber { message: "com.android.sdv.diagnostics.event.Event" allow_all_topics: true }

subscriber { message: "com.android.sdv.diagnostics.event.OperationCycle" allow_all_topics: true }

subscriber { message: "com.android.sdv.diagnostics.event.EnableCondition" allow_all_topics: true }

client {
  service: "com.android.sdv.vsidl_provider.VsidlProviderService"
  channel: "vsidl-provider-server"
}