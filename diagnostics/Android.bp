// build target for distribution of AIDL definitions
// generates zip archive at [repo root]/out/sdv/sdv-diagnostics.zip
genrule {
    name: "android.sdv.diagnostics-dist",
    srcs: [
        "aidl/**/*",
        "Android.bp",
        "README.md",
    ],
    tools: ["soong_zip"],
    out: ["sdv-diagnostics.zip"],
    cmd: "echo $(in) > $(genDir)/list && " +
        "$(location soong_zip) -sha256 -o $(out) -l $(genDir)/list",
    dists: [
        {
            targets: ["android.sdv.diagnostics-dist"],
            dir: "sdv",
        },
    ],
}
