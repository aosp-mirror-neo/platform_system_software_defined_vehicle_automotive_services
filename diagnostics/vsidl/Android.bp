package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiagnostics_api",
    crate_name: "diagnostics_api",
    protos: [
        "**/*.proto",
        ":sdv_vsidl_protos",
    ],
    source_stem: "diagnostics_api",
    use_protobuf3: true,
    proto_flags: [
        "-I external/protobuf/src",
        "-I system/software_defined_vehicle/core_services/vsidl/",
    ],
    host_supported: true,
    vendor: true,
}
