// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiagnostics_api",
    crate_name: "diagnostics_api",
    protos: [
        "*.proto",
    ],
    source_stem: "diagnostics_api",
    rustlibs: [
        "libvsidl_syntax",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
}

filegroup {
    name: "libdiagnostics_protos",
    srcs: ["*.proto"],
}

filegroup {
    name: "libdiagnostics_protos_with_bp_file",
    srcs: [
        ":libdiagnostics_protos",
        "Android.bp",
    ],
}
