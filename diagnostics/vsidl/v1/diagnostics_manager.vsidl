# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsManager"

    unit_type {
        type: "event.OperationCycle"
    }

    unit_type {
        type: "event.EnableCondition"
    }

    unit_type {
        type: "data_item.DataItemService"
    }

    unit_type {
        type: "routine_control.RoutineControlService"
    }

    unit_type {
        type: "io_control.IoControlService"
    }

    unit_type {
        type: "fault.FaultListenerService"
    }

    client {
        interface: "sdv.diagnostics.data_item.DataItemService"
    }

    client {
        interface: "sdv.diagnostics.routine_control.RoutineControlService"
    }

    client {
        interface: "sdv.diagnostics.io_control.IoControlService"
    }

    client {
        interface: "sdv.diagnostics.fault.FaultListenerService"
    }

    # TODO(b/366419229): remove once MW generator declaring unit types without service units
    server { interface: "sdv.diagnostics.data_item.DataItemService" }
    server { interface: "sdv.diagnostics.routine_control.RoutineControlService" }
    server { interface: "sdv.diagnostics.io_control.IoControlService" }
    server { interface: "sdv.diagnostics.fault.FaultListenerService" }
}