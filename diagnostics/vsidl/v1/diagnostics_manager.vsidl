    }

    unit_type {
        type: "security_access.SecurityAccessService"
    }

    unit_type {
        type: "authentication.AuthenticationService"
    }

    unit_type {
        type: "file_transfer.FileTransferService"
    }

    client {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }

    client {
        interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService"
    }

