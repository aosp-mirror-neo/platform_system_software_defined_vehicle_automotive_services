    }

    server {
        interface: "com.sdv.google.diagnostics.DiagnosticsManagerService"
    }

    # TODO(b/366419229): remove once MW generator allows declaring unit types without service units
    server { interface: "com.sdv.google.diagnostics.data_item.DataItemService" }
    server { interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService" }
    server { interface: "com.sdv.google.diagnostics.io_control.IoControlService" }
