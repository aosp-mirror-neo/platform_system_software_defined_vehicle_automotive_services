// Copyright 2024 Google LLC

rust_binary {
    name: "sdv_diagnostics_agent",
    defaults: [
        "sdv_tracing@rust_defaults",
        "sdv@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        "libbinder_rs",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libtokio",
        "libfutures",
        "libdiagnostics_v1_api",
        "libprotobuf",
        "libsdv_uds_serde_v1",
        "libsdv_config_provider",
        "libfutures_executor",
        "libsdv_dump",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
}
