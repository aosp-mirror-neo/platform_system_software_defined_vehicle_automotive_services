// Copyright 2024 Google LLC

rust_binary {
    name: "sdv_diagnostics_agent",
    defaults: [
        "sdv_tracing@rust_defaults",
        "sdv@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        "libbinder_rs",
        "libsdv_comms_rs",
        "libtokio",
        "libfutures",
        "libdiagnostics_v1_api",
        "libprotobuf",
        "google.sdv.comms-aidl-V1-rust",
        "google.sdv.rpc-aidl-V1-rust",
        "google.sdv.service_discovery.discovery-aidl-V1-rust",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
}
