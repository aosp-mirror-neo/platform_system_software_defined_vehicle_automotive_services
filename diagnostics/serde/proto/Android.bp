package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiag_serde_protos",
    crate_name: "diag_serde_protos",
    source_stem: "diag_serde_protos",
    protos: [
        ":sdv_diag_serde_protos",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    host_supported: true,
    vendor_available: true,
}

// Diagnostics serialization proto definitions
filegroup {
    name: "sdv_diag_serde_protos",
    srcs: [
        "syntax/*.proto",
    ],
}
