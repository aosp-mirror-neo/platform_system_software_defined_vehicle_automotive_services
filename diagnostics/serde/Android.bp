package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "sdv_uds_serde@rust_defaults",
    srcs: ["lib.rs"],
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "libnom",
        "libbytes",
        "libthiserror",
        "libprotobuf",
        "libserde",
    ],
    edition: "2021",
    lints: "android",
    clippy_lints: "android",
    vendor_available: true,
}

rust_library {
    name: "libsdv_uds_serde",
    crate_name: "sdv_uds_serde",
    defaults: [
        "sdv_uds_serde@rust_defaults",
    ],
    host_supported: true,
}

rust_test {
    name: "libsdv_uds_serde_tests",
    defaults: [
        "sdv_uds_serde@rust_defaults",
    ],
    rustlibs: [
        "liblazy_static",
        "libtempfile",
        "libprotobuf_parse",
        "libvsidl_syntax",
        "libserde_test",
        "libserde_json",
        "libgoogletest_rust",
    ],
    data: [
        ":sdv_vsidl_protos",
    ],
    test_options: {
        unit_test: true,
    },
}
