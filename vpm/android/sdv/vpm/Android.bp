package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "vpm_agent@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    crate_name: "sdv_vpm",
    rustlibs: [
        "libmockall",
        "libanyhow",
        "libsdv_log_rust",
        "libprotobuf",
        "liblog_rust",
        "libtokio",
        "librpcbinder_rs",
        "libbinder_tokio_rs",
        "libsdv_vpm_api",
        "libsdvmiddleware_rpc",
        "libsdvgenerated_vpm_system_service_bundle",
        "google.sdv.vpm-aidl-rust",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    shared_libs: [
        "libbinder_rpc_unstable",
    ],
    system_ext_specific: true,
    lints: "android",
    clippy_lints: "android",
}

rust_library {
    name: "libsdv_vpm",
    srcs: ["srcs/agent.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
}

rust_binary {
    name: "sdv_vpm_agent",
    srcs: ["srcs/main.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libsdv_vpm",
    ],
    system_ext_specific: true,
}

rust_test {
    name: "sdv_vpm_agent_unit_tests",
    srcs: ["srcs/agent.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    prefer_rlib: true,
}

rust_test {
    name: "sdv_vpm_agent_integration_tests",
    srcs: ["tests/integration_tests.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        "google.sdv.vpm-aidl-rust",
        "librpcbinder_rs",
        "libsdv_vpm_api",
        "libanyhow",
        "libsdv_middleware_pubsub",
        "libsdvmiddleware_rpc",
        "libsdvgenerated_vpm_integration_test_bundle",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    require_root: true,
}
