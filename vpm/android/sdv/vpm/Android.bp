// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
    // TODO(b/334018638): Add corresponding team once created.
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "vpm_agent@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    crate_name: "sdv_vpm",
    rustlibs: [
        "libmockall",
        "libanyhow",
        "libsdv_log_rust",
        "libprotobuf",
        "liblog_rust",
        "libtokio",
        "libbinder_tokio_rs",
        "libsdv_vpm_api",
        "libsdv_pm",
        "libtokio_util",
        "libthiserror",
        "libsdvmiddleware_rpc",
        "libsdv_comms_ctx_impl",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_com_sdv_google_vpm_vpm_system_service_bundle",
        "libcom_sdv_google_vpm_vpm_system_service_rpc_rs",
        "libcom_sdv_google_vpm_client_power_notification_service_rpc_rs",
        "google.sdv.vpm-aidl-rust",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    system_ext_specific: true,
    lints: "android",
    clippy_lints: "android",
}

rust_library {
    name: "libsdv_vpm",
    srcs: ["srcs/agent.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
}

rust_binary {
    name: "sdv_vpm_agent",
    srcs: ["srcs/main.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libsdv_vpm",
    ],
    system_ext_specific: true,
}

rust_test {
    name: "sdv_vpm_agent_unit_tests",
    srcs: ["srcs/agent.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    prefer_rlib: true,
}

rust_test {
    name: "sdv_vpm_agent_integration_test",
    srcs: ["tests/integration_test.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libfutures_util",
        "libsdv_mw_rs_test_sdv_vpm_vpm_system_client",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: false,
    },
    require_root: true,
}

rust_test {
    name: "sdv_vpm_agent_power_cancellation_test",
    srcs: ["tests/power_cancellation_test.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libfutures_util",
        "libsdv_mw_rs_test_sdv_vpm_vpm_system_client",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    require_root: true,
}

