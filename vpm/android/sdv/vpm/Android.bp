rust_test {
    name: "sdv_vpm_agent_power_prepare_interruption_test",
    srcs: ["tests/power_prepare_interruption_test.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
        "vpm_agent@rust_defaults",
    ],
    rustlibs: [
        "libfutures_util",
        "libsdv_mw_rs_test_sdv_vpm_vpm_system_client",
    ],
    proc_macros: [
        "libasync_trait",
    ],
