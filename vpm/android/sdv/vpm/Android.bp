package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "sdv_vpm_agent",
    crate_name: "sdv_vpm",
    srcs: ["srcs/main.rs"],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libsdv_log_rust",
        "libprotobuf",
        "liblog_rust",
        "libtokio",
        "libsdv_vpm_api",
        "libsdvmiddleware_rpc",
        "libsdvgenerated_vpm_system_service_bundle",
    ],
    system_ext_specific: true,
}
