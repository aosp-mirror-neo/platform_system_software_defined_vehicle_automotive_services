// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

genrule {
    name: "vsidlc_vpm_v1_catalog_files",
    srcs: [
        ":vpm_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libsdv_vpm_protos",
        ":system_software_defined_vehicle_automotive_services_vpm_stable_vsidl",
    ],
    tools: [
        "vsidlc",
        "soong_zip",
        "generate_zip_catalog",
    ],
    out: [
        "generated_rs.zip",
    ],
    cmd: "bash $(location generate_zip_catalog) " +
        "$(location vsidlc) " +
        "$(location soong_zip) " +
        "'$(locations :vpm_v1_catalog_files)' " +
        "$(genDir) " +
        "$(out)" +
        " '$(locations :libsdv_vpm_protos) $(locations :system_software_defined_vehicle_automotive_services_vpm_stable_vsidl)'",
}
