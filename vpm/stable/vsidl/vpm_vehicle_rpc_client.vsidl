# proto-file: //system/software_defined_vehicle/core_services/vsidl/syntax/vsidl.proto
# proto-message: VsidlEntry

package: "sdv.vpm.client"

sdv_service_bundle {
    name: "VpmSystemClient"

    # Unit type for power notification service.
    unit_type {
        type: "PowerNotificationService"
    }

    # Client for VPM system interface.
    client {
        interface: "sdv.vpm.VpmSystemService"
    }

    # Server to VPM notification interface.
    server {
        interface: "sdv.vpm.client.PowerNotificationService"
    }
}
