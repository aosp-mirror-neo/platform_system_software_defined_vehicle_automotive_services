# proto-message: VsidlEntry

package: "test.sdv.vpm"

sdv_service_bundle {
    name: "VpmSystemClient"

    subscriber {
        type:  "com.sdv.google.vpm.vehicle.VehicleStateChange"
    }

    server {
        interface: "com.sdv.google.vpm.client.PowerNotificationService"
    }

    client {
        interface: "com.sdv.google.vpm.VpmSystemService"
    }

}