// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

aidl_interface {
    name: "google.sdv.vpm-aidl",
    srcs: ["google/sdv/vpm/*.aidl"],
    unstable: true,
    owner: "google",
    backend: {
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
}
