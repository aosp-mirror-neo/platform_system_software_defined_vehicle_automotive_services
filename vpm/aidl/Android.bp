// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

aidl_interface {
    name: "google.sdv.vpm-aidl",
    srcs: ["google/sdv/vpm/*.aidl"],
    stability: "vintf",
    owner: "google",
    backend: {
        rust: {
            enabled: true,
            gen_mockall: true,
            additional_rustlibs: [
                "libmockall",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:anyapex",
                "//apex_available:platform",
            ],
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    host_supported: true,
    vendor_available: true,
    system_ext_specific: true,
    min_sdk_version: "34",
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
