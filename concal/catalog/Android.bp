package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libconcal_api",
    crate_name: "concal_api",
    protos: [
        "*.proto",
    ],
    source_stem: "concal_api",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
    host_supported: true,
    apex_available: [
        "//apex_available:platform",
    ],
    exported_include_dirs: ["."],
    min_sdk_version: "35",
}

filegroup {
    name: "libconcal_protos",
    srcs: ["*.proto"],
}

filegroup {
    name: "concal_v1_catalog_files",
    srcs: [
        ":libconcal_protos",
        "*.vsidl",
        "Android.bp",
    ],
}
