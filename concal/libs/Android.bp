package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "liboverride",
    srcs: ["src/override_lib.rs"],
    crate_name: "override",
    rustlibs: [
        "libconcal_api",
        "libprotobuf",
        "liblog_rust",
        "libsdv_log_rust",
        "libsdvtestconcal_proto_rust",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
    vendor: true,
}

rust_test {
    name: "sdv_core_automotive_services_unit_concal_override_test",
    srcs: [
        "src/override_lib.rs",
    ],
    rustlibs: [
        "libconcal_api",
        "liblog_rust",
        "libregex",
        "libprotobuf",
        "libtempfile",
        "libsdvtestconcal_proto_rust",
        "libprotobuf_parse",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    vendor: true,
    data: [
        "proto/test_configuration.proto",
        "proto/inner_test_configuration.proto",
        "proto/inner_test_configuration_different_package.proto",
    ],
}
