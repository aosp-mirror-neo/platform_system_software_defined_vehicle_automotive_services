package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libsdvtestconcal_proto_rust",
    crate_name: "sdvtestconcal_proto_rust",
    protos: [
        "test_configuration.proto",
        "inner_test_configuration.proto",
        "inner_test_configuration_different_package.proto",
        "rear_view_camera.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdvtestconcal_proto_rust",
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

filegroup {
    name: "libsdvtestconcal_proto_files",
    srcs: ["*.proto"],
}

prebuilt_etc {
    name: "rear_view_camera.proto",
    sub_dir: "protos",
    src: "rear_view_camera.proto",
}
