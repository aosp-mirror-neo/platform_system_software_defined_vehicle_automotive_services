# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for ConCal Unit Types.

acls {
    name: "Internal"
    include: "com.sdv.oem.sample.concal.SampleOemConCalServiceBundle"
}

unit_types {
    name: "ConCalRegistrationService"
    acl_names: "Internal"
}

unit_types {
    name: "ConCalUpdateService"
    acl_names: "Internal"
}

unit_types {
    name: "calib.server.ConCalCalibrationService"
    acl_names: "Internal"
}

unit_types {
    name: "calib.ConCalCalibrationNotificationService"
    acl_names: "Internal"
}
