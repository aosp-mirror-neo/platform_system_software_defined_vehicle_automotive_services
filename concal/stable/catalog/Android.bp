// Copyright 2023 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libconcal_api_stable",
    crate_name: "concal_api_stable",
    protos: [
        "*.proto",
    ],
    source_stem: "concal_api_stable",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
    ],
    min_sdk_version: "35",
}

filegroup {
    name: "libconcal_protos_stable",
    srcs: ["*.proto"],
}

filegroup {
    name: "concal_v1_catalog_files",
    srcs: [
        ":libconcal_protos_stable",
        "*.vsidl",
        "Android.bp",
    ],
}
