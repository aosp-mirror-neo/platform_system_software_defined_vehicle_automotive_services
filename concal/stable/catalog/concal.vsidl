# Copyright 2024 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.concal"

sdv_service_bundle {
  name: "ConCalServiceBundle"
  unit_type {
    access_modifier: PRIVATE
    type: "ConCalRegistrationService"
  }
  unit_type {
    access_modifier: PRIVATE
    type: "ConCalUpdateService"
  }
  unit_type {
    access_modifier: PRIVATE
    type: "sdv.concal.calib.ConCalCalibrationService"
  }
  unit_type {
    access_modifier: PRIVATE
    type: "sdv.concal.calib.ConCalCalibrationNotificationService"
  }
  unit_type {
    access_modifier: PUBLIC
    type: "sdv.concal.calib.CalibratableService"
  }
  server {
    interface: "ConCalRegistrationService"
    acl: "concal-rule-public"
  }
  server {
    interface: "ConCalUpdateService"
    acl: "concal-rule-privilleged-only"
  }
  server {
    interface: "sdv.concal.calib.ConCalCalibrationService"
    acl: "concal-rule-calib-only"
  }
  server {
    interface: "sdv.concal.calib.ConCalCalibrationNotificationService"
    acl: "concal-rule-notification-only"
  }
}

sdv_service_bundle {
  name: "ConCalClient"
  server {
    interface: "sdv.concal.calib.CalibratableService"
    acl: "only-concal-can-connect"
  }
  client {
    interface: "ConCalRegistrationService"
  }
}
