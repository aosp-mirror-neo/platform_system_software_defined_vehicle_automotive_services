// Copyright 2023 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libconcal_api",
    crate_name: "concal_api",
    protos: [
        "*.proto",
    ],
    source_stem: "concal_api",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    host_supported: true,
}

filegroup {
    name: "libconcal_protos",
    srcs: ["*.proto"],
}
