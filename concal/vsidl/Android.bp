package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libconcal_api",
    crate_name: "concal_api",
    protos: [
        "*.proto",
    ],
    source_stem: "concal_api",
    use_protobuf3: true,
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor: true,
}

filegroup {
    name: "libconcal_protos",
    srcs: ["*.proto"],
}
