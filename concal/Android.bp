// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

// build target for distribution of AIDL definitions
// generates zip archive at [repo root]/out/dist/sdv/sdv-concal.zip
genrule {
    name: "android.sdv.concal-dist",
    srcs: [
        "aidl/**/*",
        "README.md",
    ],
    tools: ["soong_zip"],
    out: ["sdv-concal.zip"],
    cmd: "echo $(in) > $(genDir)/list && " +
        "$(location soong_zip) -sha256 -o $(out) -l $(genDir)/list",
    dists: [
        {
            targets: ["android.sdv.concal-dist"],
            dir: "sdv",
        },
    ],
}

// build target for distribution of VSIDL definitions
// generates zip archive at [repo root]/out/dist/sdv/libconcal_api.zip
genrule {
    name: "libconcal_api-dist",
    srcs: [
        "vsidl/**/*",
        "README.md",
    ],
    tools: ["soong_zip"],
    out: ["libconcal_api.zip"],
    cmd: "echo $(in) > $(genDir)/list && " +
        "$(location soong_zip) -sha256 -o $(out) -l $(genDir)/list",
    dists: [
        {
            targets: ["libconcal_api-dist"],
            dir: "sdv",
        },
    ],
}
