package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "sdv_vpm_agent",
    srcs: ["srcs/service/main.rs"],
    defaults: ["sdv@rust_defaults"],
    prefer_rlib: true,
    rustlibs: [
        "android.sdv.vpm-aidl-rust",
        "librpcbinder_rs",
        "libanyhow",
        "libsdv_log_rust",
        "liblog_rust",
        "libsdv_sd_rs",
        "liblibc",
        "libtokio",
        "libbinder_tokio_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    shared_libs: [
        "libbinder_rpc_unstable",
    ],
    system_ext_specific: true,
}
