package {
    default_applicable_licenses: ["sdv_license"],
}

rust_library {
    name: "liboverride",
    srcs: ["src/override_lib.rs"],
    crate_name: "override",
    rustlibs: [
        "libconcal_api",
        "libprotobuf",
        "liblog_rust",
        "libsdv_log_rust",
        "libsdvtestconcal_proto_rust",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
}

rust_test_host {
    name: "lib_override_tests",
    srcs: [
        "src/override_lib.rs",
    ],
    rustlibs: [
        "libconcal_api",
        "liblog_rust",
        "libprotobuf",
        "libtempfile",
        "libsdvtestconcal_proto_rust",
        "libprotobuf_parse",
    ],
    test_options: {
        unit_test: true,
    },
    vendor: true,
    data: [
        "proto/test_configuration.proto",
        "proto/inner_test_configuration.proto",
        "proto/inner_test_configuration_different_package.proto",
    ],
}
