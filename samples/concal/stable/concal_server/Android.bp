// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

// Lifecycle-Manager Required Library for ConCal Service Bundle.
rust_ffi_shared {
    name: "libconcal_service_bundle_runner",
    crate_name: "concal_service_bundle_runner",
    srcs: ["src/concal_sb_lib.rs"],
    rustlibs: [
        "libconcal_api_stable",
        "liblog_rust",
        "libprotobuf",
        "librand",
        // Commstack library that provides context object reference.
        "libsdv_comms_rs",
        "libcom_sdv_google_concal_con_cal_registration_service_rpc_rs",
        "libcom_sdv_google_concal_con_cal_update_service_rpc_rs",
        "libcom_sdv_google_concal_calib_server_con_cal_calibration_service_rpc_rs",
        "libcom_sdv_google_concal_calib_con_cal_calibration_notification_service_rpc_rs",
        // Contains service bundle interface definitions and helper macros.
        "libsdv_lifecycle_client_rust",
        "libsdv_mw_rs_sdv_comms",
        // Generated MW code for ConCal Service Bundle.
        "libsdv_mw_rs_com_sdv_oem_sample_concal_sample_oem_con_cal_service_bundle",
        "libsdv_status_rs",
        "libtokio",
        "libtokio_util",
    ],
    // Allows the library to be available inside the ConCal APEX.
    apex_available: [
        "com.sdv.oem.sample.concal",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    // ConCal service bundle package is packed into /product apexes.
    product_specific: true,
    proc_macros: [
        "libasync_trait",
    ],
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_automotive_services_unit_concal_server_sample_test",
    srcs: [
        "src/concal_sb_lib.rs",
    ],
    rustlibs: [
        "libconcal_api_stable",
        "libitertools",
        "liblog_rust",
        "libprotobuf_parse",
        "libprotobuf",
        "librand",
        "libsdv_comms_rs",
        "libcom_sdv_google_concal_con_cal_registration_service_rpc_rs",
        "libcom_sdv_google_concal_con_cal_update_service_rpc_rs",
        "libcom_sdv_google_concal_calib_server_con_cal_calibration_service_rpc_rs",
        "libcom_sdv_google_concal_calib_con_cal_calibration_notification_service_rpc_rs",
        "libsdv_lifecycle_client_rust",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_com_sdv_oem_sample_concal_sample_oem_con_cal_service_bundle",
        "libsdv_status_rs",
        "libsdvtestconcal_proto_rust",
        "libtempfile",
        "libtokio_util",
        "libtokio",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    data: [
        ":libsdvtestconcal_proto_files",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
}
