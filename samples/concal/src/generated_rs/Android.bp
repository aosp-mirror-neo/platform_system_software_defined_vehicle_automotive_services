// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

genrule {
    name: "vsidlc_concal_v1_catalog_files",
    srcs: [
        ":concal_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libconcal_protos",
    ],
    tools: [
        "vsidlc",
        "soong_zip",
        "generate_zip_catalog",
    ],
    out: [
        "generated_rs.zip",
    ],
    cmd: "bash $(location generate_zip_catalog) " +
        "$(location vsidlc) " +
        "$(location soong_zip) " +
        "'$(locations :concal_v1_catalog_files)' " +
        "$(genDir) " +
        "$(out)" +
        " '$(locations :libconcal_protos)'",
}
