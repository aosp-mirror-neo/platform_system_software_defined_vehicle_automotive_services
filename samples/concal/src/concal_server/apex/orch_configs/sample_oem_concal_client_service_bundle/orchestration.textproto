# proto-message: ServiceBundleConfig

# Service bundle FQIN with instance.
package_name: "com.sdv.oem.sample.concal"
service_bundle_name: "SampleOemConCalClientServiceBundle"
instance: "sample"

## Group of service bundles to be started on boot.
group_mapping { group: "sample_oem_concal_client_service_bundle_auto_start" instance: "sample" }
