# system/software_defined_vehicle/orchestration/distributed_config/src/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

# Service bundle FQIN with instance.
package_name: "com.sdv.oem.sample.concal"
service_bundle_name: "SampleOemConCalServiceBundle"
instance: "default"

## Group of service bundles to be started on boot.
group_mapping { group: "sample_oem_concal_service_bundle_auto_start" instance: "default" }
