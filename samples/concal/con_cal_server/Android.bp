rust_binary {
    name: "sdv_con_cal_service",
    crate_name: "sdv_con_cal_service",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_con_cal_server",
        "libconcal_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
    ],
    vendor: true,
}

rust_test_host {
    name: "sdv_con_cal_service_tests",
    srcs: [
        "src/trie.rs",
    ],
    rustlibs: [
        "libconcal_api",
        "liblog_rust",
        "libprotobuf",
        "libtempfile",
        "libsdvtestconcal_proto_rust",
        "libprotobuf_parse",
    ],
    test_options: {
        unit_test: true,
    },
    vendor: true,
    data: [
    ],
}
