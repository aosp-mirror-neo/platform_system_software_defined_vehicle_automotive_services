// Copyright 2023 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "sdv_con_cal_service",
    crate_name: "sdv_con_cal_service",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_con_cal_server",
        "libconcal_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libsdvtestconcal_proto_rust",
        "libprotobuf_parse",
    ],
    vendor: true,
}

rust_test {
    name: "sdv_con_cal_service_tests",
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libconcal_api",
        "liblog_rust",
        "libprotobuf",
        "libtempfile",
        "libprotobuf_parse",
        "libsdvgenerated_con_cal_server",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libsdvtestconcal_proto_rust",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    vendor: true,
    data: [
        ":libsdvtestconcal_proto_files",
    ],
}
