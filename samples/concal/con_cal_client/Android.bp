rust_binary {
    name: "sdv_con_cal_client",
    crate_name: "sdv_con_cal_client",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_con_cal_client",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libconcal_api",
        "libsdvtestconcal_proto_rust",
        "libprotobuf_parse",
    ],
    vendor: true,
}
