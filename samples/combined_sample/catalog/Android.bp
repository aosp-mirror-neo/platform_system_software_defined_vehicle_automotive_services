// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libcombined_sample_v1_catalog",
    crate_name: "combined_sample_v1_catalog",
    protos: [
        ":combined_sample_v1_protos",
    ],
    source_stem: "combined_sample_v1_catalog",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libconcal_api",
        "libdiagnostics_v1_api",
        "libuser_preferences_api_stable",
        "libsdv_vpm_api",
        "libhealth_api",
        "libsdv_orch_api_stable",
        "libupdate_manager_api",
        "libvsidl_v1_stdlib_proto_rs",
    ],
    vendor_available: true,
    product_available: true,
}

filegroup {
    name: "combined_sample_v1_protos",
    srcs: ["*.proto"],
}

filegroup {
    name: "combined_sample_v1_catalog_files",
    srcs: [
        ":combined_sample_v1_protos",
        "*.vsidl",
        "Android.bp",
    ],
}
