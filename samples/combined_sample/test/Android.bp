rust_test {
    name: "sdv_combined_sample_generation_test",
    srcs: ["per_vm_generation.rs"],
    data: [
        ":generate_sample_rc_files",
    ],
    test_suites: [
        "automotive-sdv-tests",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    test_options: {
        unit_test: true,
    },
    require_root: true,
}

