rust_test {
    name: "sdv_combined_sample_generation_test",
    srcs: ["per_vm_generation.rs"],
    data: [
        ":generate_vsidl_files_combined_sample_v1_catalog_files",
    ],
    test_suites: [
        "automotive-sdv-tests",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    test_options: {
        unit_test: true,
    },
    require_root: true,
}

