// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

genrule {
    name: "generate_sample_rc_files",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":combined_sample_v1_catalog_files",
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
    ],

    cmd: "$(location vsidl_rc_generator) --vsidl-path system/software_defined_vehicle/core_services/vsidl/protos --catalog-path system/software_defined_vehicle/automotive_services/samples/combined_sample/catalog --output-path $(genDir) " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/concal/stable/catalog/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/user_preferences/vsidl/v1/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/vpm/stable/vsidl/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/health_monitor/catalog/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/orchestration/engine/stable/vsidl/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/update_manager/catalog/",
    out: [
        "vsidl-config.binpb",
        "someip-config.binpb",
    ],
}

genrule {
    name: "generate_sample_per_bundle_rc_files",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":combined_sample_v1_catalog_files",
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
    ],

    cmd: "$(location vsidl_rc_generator) --vsidl-path system/software_defined_vehicle/core_services/vsidl/protos --catalog-path system/software_defined_vehicle/automotive_services/samples/combined_sample/catalog --output-path $(genDir) " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/concal/stable/catalog/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/user_preferences/vsidl/v1/ " +
        "--dependency-catalog-path system/software_defined_vehicle/automotive_services/vpm/stable/vsidl/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/health_monitor/catalog/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/orchestration/engine/stable/vsidl/ " +
        "--dependency-catalog-path system/software_defined_vehicle/core_services/update_manager/catalog/ " +
        " --service-bundle-name SampleServiceWithAllDependencies",
    out: [
        "vsidl-config.binpb",
        "diagnostics-config.binpb",
    ],
}
