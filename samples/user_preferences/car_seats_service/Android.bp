package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_binary {
    name: "sdv_car_seats_service",
    crate_name: "sdv_car_seats_service",
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_car_seats_service",
        "libuser_preferences_api",
        "libsdvmiddleware_rpc",
        "libitertools",
        "libprotobuf_parse",
        "libuser_preferences_utils",
        "libsdvmiddleware_rpc_grpc_transport",
        "libuser_controllable_service_impl",
    ],
    vendor: true,
}
