// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

genrule {
    name: "vsidlc_user_preferences_v1_catalog_files",
    srcs: [
        ":user_preferences_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libuser_preferences_protos_stable",
    ],
    tools: [
        "vsidlc",
        "soong_zip",
        "generate_zip_catalog",
    ],
    out: [
        "generated_rs.zip",
    ],
    cmd: "bash $(location generate_zip_catalog) " +
        "$(location vsidlc) " +
        "$(location soong_zip) " +
        "'$(locations :user_preferences_v1_catalog_files)' " +
        "$(genDir) " +
        "$(out)" +
        " '$(locations :libuser_preferences_protos_stable)'",
}
