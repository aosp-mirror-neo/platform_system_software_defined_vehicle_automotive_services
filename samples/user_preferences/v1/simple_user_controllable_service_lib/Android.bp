rust_library {
    name: "libuser_controllable_service_impl_stable",
    srcs: ["src/simple_user_controllable_service_impl.rs"],
    crate_name: "user_controllable_service_impl",
    rustlibs: [
        "libtokio",
        "libfutures",
        "liblog_rust",
        "libprotobuf",
        "libitertools",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libuser_preferences_api_stable",
        "libcom_sdv_google_user_preferences_user_preferences_registry_service_rpc_rs",
        "libcom_sdv_google_user_preferences_user_controllable_user_controllable_service_rpc_rs",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    product_available: true,
    ld_flags: ["-Wl,--no-as-needed"],
}
