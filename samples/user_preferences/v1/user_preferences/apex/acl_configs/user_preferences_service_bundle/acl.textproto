# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for User Preferences Unit Types.

acls {
    name: "PackagePublic"
    include: "com.sdv.google.user_preferences.UserPreferencesAdminServiceClient"
    include: "com.sdv.oem.user_preferences.*"
    include: "com.android.testapp.sdvcarmonitor.SDVCarMonitorProductTestApp"
    include: "com.android.testapp.sdvcarmonitor.SdvCarMonitorTestApp"
    include: "com.android.testapp.sdvcarmonitor.SDVCarMonitorVendorTestApp"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-management-service"
    acl_names: "PackagePublic"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-registry-service"
    acl_names: "PackagePublic"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-admin-service"
    acl_names: "PackagePublic"
}
