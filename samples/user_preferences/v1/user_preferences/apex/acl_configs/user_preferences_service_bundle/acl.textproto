# proto-file: //system/software_defined_vehicle/core_services/service_authz/policy/src/proto/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for User Preferences Unit Types.

acls {
    name: "PackagePublic"
    include: "com.sdv.oem.user_preferences.*"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-management-service"
    acl_names: "PackagePublic"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-registry-service"
    acl_names: "PackagePublic"
}

service_units {
    name: "com-sdv-google-user-preferences-user-preferences-admin-service"
    acl_names: "PackagePublic"
}
