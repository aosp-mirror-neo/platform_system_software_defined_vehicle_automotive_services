// Copyright 2024 Google LLC

rust_ffi_shared {
    name: "libuser_preferences_service_stable",
    crate_name: "user_preferences_service_stable",
    defaults: ["libuser_preferences_stable@rust_defaults"],
    proc_macros: [
        "libasync_trait",
    ],
    apex_available: [
        "com.sdv.oem.user_preferences",
    ],
    product_specific: true,
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_test {
    name: "sdv_user_preferences_service_stable_tests",
    defaults: ["libuser_preferences_stable@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    auto_gen_config: true,
    ld_flags: ["-Wl,--no-as-needed"],
    require_root: true,
}

rust_defaults {
    name: "libuser_preferences_stable@rust_defaults",
    srcs: [
        "src/main.rs",
    ],
    defaults: [
        "sdv@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "liblog_rust",
        "libsdv_log_rust",
        "libtokio",
        "libtokio_util",
        "libfutures",
        "libmockall",
        "librusqlite",
        "librustutils",
        "libitertools",
        "libtempfile",
        "libserde",
        "libprotobuf",
        "libbinder_tokio_rs",
        "libbinder_rs",
        "liblazy_static",
        "libserde_json",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libuser_preferences_api_stable",
        "libsdv_mw_rs_com_sdv_oem_user_preferences_user_preferences_service_bundle",
        "libcom_sdv_google_user_preferences_user_preferences_admin_service_rpc_rs",
        "libcom_sdv_google_user_preferences_user_preferences_management_service_rpc_rs",
        "libcom_sdv_google_user_preferences_user_preferences_registry_service_rpc_rs",
        "libcom_sdv_google_user_preferences_view_change_notifier_rpc_rs",
        "libcom_sdv_google_user_preferences_user_controllable_user_controllable_service_rpc_rs",
        // Contains service bundle interface definitions and helper macros.
        "libsdv_lifecycle_client_rust",
    ],
    product_specific: true,
}
