// Copyright 2024 Google LLC

rust_binary {
    name: "sdv_user_preferences_service_stable",
    crate_name: "sdv_user_preferences_service_stable",
    srcs: [
        "src/main.rs",
    ],
    defaults: ["sdv_user_preferences_stable@rust_defaults"],
    proc_macros: [
        "libasync_trait",
    ],
    system_ext_specific: true, //TODO(b/370402920): Move to product partition instead
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_defaults {
    name: "sdv_user_preferences_stable@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "liblog_rust",
        "libsdv_log_rust",
        "libtokio",
        "libfutures",
        "librustutils",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_sdv_user_preferences_user_preferences_service_bundle",
        "libsdv_user_preferences_user_preferences_admin_service_rpc_rs",
        "libsdv_user_preferences_user_preferences_management_service_rpc_rs",
        "libsdv_user_preferences_user_preferences_registry_service_rpc_rs",
        "libsdv_user_preferences_view_change_notifier_rpc_rs",
        "libsdv_user_preferences_user_controllable_user_controllable_service_rpc_rs",
    ],
    system_ext_specific: true, //TODO(b/370402920): Move to product partition instead
}
