// Global (SDV VM instance) orchestration configurations.
// One or another are to be set with `persist.sdv.orchestrator_config_path` property.
prebuilt_etc {
    name: "user_preferences_samples_orch_config",
    srcs: [
        // Configuration to start HvacService bundle on boot.
        "vm_user_preferences_sample_orch_config.textproto",
    ],
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
}
