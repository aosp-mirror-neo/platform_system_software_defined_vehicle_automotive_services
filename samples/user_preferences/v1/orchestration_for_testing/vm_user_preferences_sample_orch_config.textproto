# proto-file:
# system/software_defined_vehicle/core_services/orchestration/distributed_config/src/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

# Group all subgroups to be started on boot.
group_mapping {
  group: "auto_start"
  subgroup: "hvac_service_auto_start"
  subgroup: "hmi_service_auto_start"
  subgroup: "car_seats_service_auto_start"
}

# Start `auto_start` service bundles when system is started.
state {
  condition {
    or { power_state: "ON" power_state: "POWER_OFF_EXIT" power_state: "SUSPEND_TO_RAM_EXIT" }
  }
  groups_states { started: "auto_start" }
}

# Start `auto_start` service bundles when system is started.
state {
  condition { or { power_state: "ON" power_state: "POWER_OFF_EXIT" } }
  groups_states { started: "auto_start" }
}
