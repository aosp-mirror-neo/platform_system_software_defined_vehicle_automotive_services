// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_ffi_shared {
    name: "libsdv_hvac_service",
    crate_name: "sdv_hvac_service",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libsdv_rs",
        "libanyhow",
        "libtokio",
        "libtokio_util",
        "libfutures",
        "liblog_rust",
        "libprotobuf",
        "libitertools",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libuser_preferences_api_stable",
        "libuser_controllable_service_impl_stable",
        "libsdv_mw_rs_com_sdv_oem_user_preferences_hvac_service",
        "libcom_sdv_google_user_preferences_user_preferences_registry_service_rpc_rs",
        "libcom_sdv_google_user_preferences_user_controllable_user_controllable_service_rpc_rs",
        // Contains service bundle interface definitions and helper macros.
        "libsdv_lifecycle_client_rust",
    ],
    product_specific: true,
    ld_flags: ["-Wl,--no-as-needed"],
    // Allows the library to be available inside of the related APEX.
    apex_available: ["com.sdv.oem.user_preferences"],
}
