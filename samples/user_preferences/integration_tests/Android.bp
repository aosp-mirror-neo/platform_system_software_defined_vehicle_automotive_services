package {
    default_applicable_licenses: ["sdv_license"],
}

rust_test {
    name: "sdv_user_preferences_integration_test",
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    srcs: ["src/main.rs"],
    rustlibs: [
        "libprotobuf",
        "libsdvmiddleware_rpc_grpc_transport",
        "libuser_preferences_api",
        "liblog_rust",
        "libnamed_lock",
        "libsdv_log_rust",
        "libsdvmiddleware_rpc",
        "libsdvgenerated_mock_user_preferences_client",
        "liblazy_static",
    ],
    vendor: true,
    require_root: true,
}
