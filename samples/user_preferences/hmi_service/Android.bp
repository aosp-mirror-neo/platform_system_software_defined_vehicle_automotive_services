package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_binary {
    name: "sdv_hmi_service",
    crate_name: "sdv_hmi_service",
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_rpc_sdv_user_preferences_user_preferences_view",
        "libsdvgenerated_rpc_sdv_user_preferences_user_preferences_management_service",
        "libsdvgenerated_rpc_sdv_user_preferences_user_preferences_admin_service",
        "libsdvgenerated_hmi_service",
        "libuser_preferences_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libprotobuf_parse",
        "libuser_preferences_utils",
    ],
    vendor: true,
}
