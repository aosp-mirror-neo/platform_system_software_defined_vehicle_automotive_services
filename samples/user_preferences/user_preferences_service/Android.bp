// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_binary {
    name: "sdv_user_preferences_service",
    crate_name: "sdv_user_preferences_service",
    defaults: ["sdv_user_preferences@rust_defaults"],
}

rust_test {
    name: "sdv_user_preferences_service_tests",
    defaults: ["sdv_user_preferences@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    auto_gen_config: true,
    require_root: true,
}

rust_defaults {
    name: "sdv_user_preferences@rust_defaults",
    srcs: [
        "src/main.rs",
    ],
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        // Recommended for handling errors in *executables*
        "libanyhow",
        "libprotobuf",
        "libsdvgenerated_user_preferences_server",
        "libuser_preferences_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "liblog_rust",
        "libuser_preferences_utils",
        "libprotobuf_parse",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_rpc_sdv_user_preferences_user_controllable_user_controllable_service",
        "libsdvgenerated_rpc_sdv_user_preferences_view_change_notifier",
        "libtempfile",
        "librusqlite",
        "libclap",
        "libthiserror",
        "libserde",
        "libserde_json",
        "libmockall",
        "liblazy_static",
    ],
    vendor: true,
}
