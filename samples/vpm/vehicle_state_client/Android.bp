// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "vpm_vehicle_state_client",
    crate_name: "vpm_vehicle_state_client",
    srcs: ["src/main.rs"],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libsdv_log_rust",
        "libprotobuf",
        "liblog_rust",
        "libsdv_vpm_api",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
        "libsdv_comms_rs",
        "libtokio",
        "libfutures_util",
        "libsdv_middleware_pubsub",
        "libsdv_mw_rs_com_sdv_google_vpm_vehicle_client_subscriber_vehicle_state_subscriber",
        "libsdv_mw_rs_com_sdv_google_vpm_vpm_system_service_bundle",
    ],
    system_ext_specific: true,
    ld_flags: ["-Wl,--no-as-needed"],
}
