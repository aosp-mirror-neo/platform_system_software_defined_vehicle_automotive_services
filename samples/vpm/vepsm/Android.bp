// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "vepsm",
    crate_name: "vepsm",
    srcs: ["src/main.rs"],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libclap",
        "libsdv_log_rust",
        "libprotobuf",
        "liblog_rust",
        "libsdv_vpm_api",
        "libsdv_vpm_api",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
        "libsdv_comms_rs",
        "libtokio",
        "libsdv_status_rs",
        "libsdvmiddleware_rpc",
        "libsdv_mw_rs_sdv_vpm_client_vpm_system_client",
        "libsdv_vpm_vpm_system_service_rpc_rs",
        "libsdv_vpm_client_power_notification_service_rpc_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    system_ext_specific: true,
}
