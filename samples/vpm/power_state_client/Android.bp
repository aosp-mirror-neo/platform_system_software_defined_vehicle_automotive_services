// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "vpm_power_state_client",
    srcs: ["src/main.rs"],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "google.sdv.vpm-aidl-rust",
        "liblog_rust",
        "libanyhow",
        "libsdv_log_rust",
        "libtokio",
        "libbinder_tokio_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
    system_ext_specific: true,
}
