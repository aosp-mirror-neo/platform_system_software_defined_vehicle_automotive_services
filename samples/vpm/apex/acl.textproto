# Copyright 2024 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for VPM Client Unit Types.

# RPC interface ACL: who can implement that interface.
acls {
    name: "Internal"
    include: "com.sdv.google.vpm.client.VpmSystemClient"
}

# RPC server ACL: who can discover and connect to the server.
acls {
    name: "VpmSystemClients"
    include: "com.sdv.google.vpm.VpmSystemServiceBundle"
}

unit_types {
    name: "PowerNotificationService"
    acl_names: "Internal"
}

service_units {
    name: "com-sdv-google-vpm-client-power-notification-service"
    acl_names: "VpmSystemClients"
}
