rust_binary {
    name: "sdv_user_profile_service",
    crate_name: "sdv_user_profile_service",
    srcs: [
        "src/main.rs",
    ],
    defaults: ["sdv_user_profile@rust_defaults"],
    rustlibs: [
    ],
    vendor: true,
}

rust_test {
    name: "sdv_user_profile_service_tests",
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [

    ],
    defaults: ["sdv_user_profile@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    vendor: true,
}

rust_defaults {
    name: "sdv_user_profile@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libprotobuf",
        "libsdvgenerated_user_profile_server",
        "libuser_profile_api",
        "libbinder_rs",
        "libsdvmiddleware_rpc",
        "libitertools",
        "librand",
        "libuser_profile_utils",
        "libprotobuf_parse",
        "libsdvmiddleware_rpc_grpc_transport",
        "libsdvgenerated_rpc_user_controllable_service",
        "libsdvgenerated_rpc_user_profile_view",
    ],
}
