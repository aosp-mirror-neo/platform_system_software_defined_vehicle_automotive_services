package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libuserprofile_sample",
    crate_name: "userprofile_sample",
    protos: [
        "**/*.proto",
        ":sdv_vsidl_protos",
    ],
    source_stem: "userprofile_sample",
    proto_flags: [
        "-I external/protobuf/src",
        "-I system/software_defined_vehicle/core_services/vsidl/protos",
    ],
    host_supported: true,
    vendor: true,
}
