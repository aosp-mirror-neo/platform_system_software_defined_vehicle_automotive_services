# Copyright 2023 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/vsidl/syntax/vsidl.proto
# proto-message: VsidlEntry

package: "sdv.sample.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsManagerService"
    client: "sdv.diagnostics.data_item.DataItem"
    server: "sdv.diagnostics.manager.DiagnosticsManager"
    subscriber: "sdv.diagnostics.event.Event"
}

sdv_service_bundle {
    name: "DiagnosticsProviderService1"
    server: "sdv.diagnostics.data_item.DataItem"
    publisher: "sdv.diagnostics.event.Event::DIAGNOSTICS_PROVIDER1_SAMPLE"

    diagnostics_declaration {
        data_item {
            id: "data_item_id1"
            message_name: "sdv.sample.diagnostics.DataItemOne"
            is_writable: true
        }

        io_control {
            id: "io_control_data1"
            message_name: "sdv.sample.diagnostics.IOControllableData"
        }

        event {
            id: "event1"
            extended_data_message_name: "sdv.sample.diagnostics.EventExtendedData"
            fault_listener_mask: 0x1
        }

        routine {
            id: "routine1"
            start {
                request: "sdv.sample.diagnostics.RoutineRequestParameter"
                response: "sdv.sample.diagnostics.RoutineResponseParameter"
            }
            stop {
                request: "sdv.sample.diagnostics.RoutineRequestParameter"
                response: "sdv.sample.diagnostics.RoutineResponseParameter"
            }
            result {
                request: "sdv.sample.diagnostics.RoutineRequestParameter"
                response: "sdv.sample.diagnostics.RoutineResponseParameter"
            }
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsProviderService2"
    server: "sdv.diagnostics.data_item.DataItem"
    publisher: "sdv.diagnostics.event.Event::DIAGNOSTICS_PROVIDER2_SAMPLE"

    diagnostics_declaration {
        data_item {
            id: "data_item_id2"
            message_name: "sdv.sample.diagnostics.DataItemTwo"
        }
    }
}
