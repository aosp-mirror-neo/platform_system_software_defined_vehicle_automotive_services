# Copyright 2023 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/vsidl/syntax/vsidl.proto
# proto-message: VsidlEntry

package: "sdv.sample.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsManager"
    client: "sdv.diagnostics.data_item.DataItemService"
    client: "sdv.diagnostics.routine_control.RoutineControlService"
    client: "sdv.diagnostics.io_control.IoControlService"
    client: "sdv.diagnostics.fault.FaultListenerService"
    server: "sdv.diagnostics.DiagnosticsManagerService"
    subscriber: "DataItemViaDataTunnel"
}

sdv_service_bundle {
    name: "DiagnosticsProviderService1"
    server: "sdv.diagnostics.data_item.DataItemService"
    server: "sdv.diagnostics.routine_control.RoutineControlService"
    server: "sdv.diagnostics.io_control.IoControlService"
    server: "sdv.diagnostics.fault.FaultListenerService"
    publisher: "DataItemViaDataTunnel"

    diagnostics_declaration {
        data_item {
            id: "data_item_id1"
            message_name: "sdv.sample.diagnostics.DataItemOne"
            is_writable: true
        }

        io_control {
            id: "io_control_data1"
            message_name: "sdv.sample.diagnostics.IoControllableData"
        }

        event {
            id: "event.1"
            extended_data_message_name: "sdv.sample.diagnostics.FirstEventExt"
            fault_listener_mask: 0x3
        }

        event {
            id: "event.number2"
            extended_data_message_name: "sdv.sample.diagnostics.SecondEventExt"
            fault_listener_mask: 0x1
        }

        routine {
            id: "routine1"
            start {
                request: "sdv.sample.diagnostics.RoutineRequestParameter"
                response: "sdv.sample.diagnostics.RoutineResponseParameter"
            }
            stop {
                request: "sdv.sample.diagnostics.RoutineRequestParameter"
                response: "sdv.sample.diagnostics.RoutineResponseParameter"
            }
            result {
                request: "sdv.sample.diagnostics.Empty"
                response: "sdv.sample.diagnostics.Empty"
            }
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsProviderService2"
    server: "sdv.diagnostics.data_item.DataItemService"
    server: "sdv.diagnostics.fault.FaultListenerService"

    diagnostics_declaration {
        data_item {
            id: "data_item_id2"
            message_name: "sdv.sample.diagnostics.DataItemTwo"
        }

        event {
            id: "event.2"
            extended_data_message_name: "sdv.sample.diagnostics.SecondEventExt"
            fault_listener_mask: 0x0
        }
    }
}
