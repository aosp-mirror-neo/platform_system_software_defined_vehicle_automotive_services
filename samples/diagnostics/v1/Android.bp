// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "diag_v1_samples@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    crate_name: "diag_v1_samples",
    rustlibs: [
        "libdiagnostics_v1_api",
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libsdvmiddleware_rpc",
        "libdiagnostics_v1_sample_catalog",
        "libtokio",
        "libsdv_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    system_ext_specific: true,
}

rust_binary {
    name: "diag_v1_provider1_sample",
    defaults: ["diag_v1_samples@rust_defaults"],
    srcs: ["src/service1.rs"],
    ld_flags: ["-Wl,--no-as-needed"],
    rustlibs: [
        "libsdv_mw_rs_sdv_sample_diagnostics_diagnostics_provider1",
    ],
}

rust_binary {
    name: "diag_v1_provider2_sample",
    defaults: ["diag_v1_samples@rust_defaults"],
    srcs: ["src/service2.rs"],
    ld_flags: ["-Wl,--no-as-needed"],
    rustlibs: [
        "libsdv_mw_rs_sdv_sample_diagnostics_diagnostics_provider2",
    ],
}
