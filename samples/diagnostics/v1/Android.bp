package {
    default_applicable_licenses: ["sdv_license"],
}

rust_ffi_shared {
    name: "libdiag_v1_provider1_sample",
    crate_name: "diag_v1_provider1_sample",
    srcs: ["src/service1.rs"],
    ld_flags: ["-Wl,--no-as-needed"],
    rustlibs: [
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libdiagnostics_v1_sample_catalog",
        "libtokio",
        "libtokio_util",
        "libfutures",
        "libsdv_rs",
        "libsdv_status_rs",
        "libsdv_dump",
        "librand",
        "libsdv_comms_rs",
        "libsdv_mw_rs_com_sdv_oem_sample_diagnostics_diagnostics_provider1",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    product_specific: true,
    min_sdk_version: "35",
    apex_available: ["com.sdv.oem.sample.diagnostics"],
}

rust_ffi_shared {
    name: "libdiag_v1_provider2_sample",
    crate_name: "diag_v1_provider2_sample",
    srcs: ["src/service2.rs"],
    rustlibs: [
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libdiagnostics_v1_sample_catalog",
        "libtokio",
        "libtokio_util",
        "libfutures",
        "libsdv_rs",
        "libsdv_dump",
        "libsdv_mw_rs_com_sdv_oem_sample_diagnostics_diagnostics_provider2",
        "libsdv_status_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
    min_sdk_version: "35",
    apex_available: ["com.sdv.oem.sample.diagnostics"],
}
