# Copyright 2024 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.oem.sample.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsProvider1"

    server {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }
    server {
        interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.io_control.IoControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.fault.FaultListenerService"
    }

    diagnostics_declaration {
        event {
            id: "lowpressure"
            extended_data_message_name: "LowPressureData"
            fault_listener_mask: 0x3
        }

        event {
            id: "pressure-change"
            extended_data_message_name: "Pressure"
            service_unit_name: "pressure-change-publisher"
        }

        data_item {
            id: "pressure"
            message_name: "Pressure"
        }

        data_item {
            id: "low_pressure_threshold"
            message_name: "Pressure"
            is_writable: true
        }

        routine {
            id: "pressurization"
            start {
                request: "Pressure"
            }
        }

        io_control {
            id: "pressure"
            message_name: "Pressure"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsProvider2"

    diagnostics_declaration {
        event {
            id: "overheating"
            extended_data_message_name: "OverheatingData"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithDataItem"

    # Declare server of a DataItemService
    server {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }

    diagnostics_declaration {
        # describe provided data items
        data_item {
            id: "pressure"
            message_name: "Pressure"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithEvent"

    publisher {
        type: "com.sdv.google.diagnostics.event.EnableCondition"
        service_unit_name: "traction-on"
    }

    publisher {
        type: "com.sdv.google.diagnostics.event.OperationCycle"
        service_unit_name: "ignition"
    }

    diagnostics_declaration {
        event {
            id: "overheating"
            extended_data_message_name: "OverheatingData"
            service_unit_name: "overheating-event"
        }
    }
}