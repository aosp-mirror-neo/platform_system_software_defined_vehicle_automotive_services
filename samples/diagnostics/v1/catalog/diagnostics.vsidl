# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.oem.sample.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsProvider1"

    server {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }
    server {
        interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.io_control.IoControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.fault.FaultListenerService"
    }

    diagnostics_declaration {
        event {
            id: "lowpressure"
            extended_data_message_name: "LowPressureData"
            fault_listener_mask: 0x3
        }

        event {
            id: "pressure-change"
            extended_data_message_name: "Pressure"
            service_unit_name: "pressure-change-publisher"
        }

        data_item {
            id: "pressure"
            message_name: "Pressure"
        }

        data_item {
            id: "low_pressure_threshold"
            message_name: "Pressure"
            is_writable: true
        }

        routine {
            id: "pressurization"
            start {
                request: "Pressure"
            }
        }

        io_control {
            id: "pressure"
            message_name: "Pressure"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsProvider2"

    diagnostics_declaration {
        event {
            id: "overheating"
            extended_data_message_name: "OverheatingData"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithDataItem"

    # Declare server of a DataItemService
    server {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }

    diagnostics_declaration {
        # describe provided data items
        data_item {
            id: "pressure"
            message_name: "Pressure"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithEvent"

    publisher {
        type: "com.sdv.google.diagnostics.event.EnableCondition"
        service_unit_name: "traction-on"
    }

    publisher {
        type: "com.sdv.google.diagnostics.event.OperationCycle"
        service_unit_name: "ignition"
    }

    server {
        interface: "com.sdv.google.diagnostics.fault.FaultListenerService"
        service_unit_name: "overheating-fault"
    }

    diagnostics_declaration {
        event {
            id: "overheating"
            extended_data_message_name: "OverheatingData"
            service_unit_name: "overheating-event"
            fault_listener_mask: 0x1
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithEcuReset"

    server {
        interface: "com.sdv.google.diagnostics.ecu_reset.EcuResetService"
    }

    client {
        interface: "com.sdv.google.diagnostics.DiagnosticsManagerService"
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithAuthentication"

    server {
        interface: "com.sdv.google.diagnostics.authentication.AuthenticationService"
    }

    client {
        interface: "com.sdv.google.diagnostics.DiagnosticsManagerService"
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithSecurityAccess"

    server {
        interface: "com.sdv.google.diagnostics.security_access.SecurityAccessService"
    }

    client {
        interface: "com.sdv.google.diagnostics.DiagnosticsManagerService"
    }
}

sdv_service_bundle {
    name: "DiagnosticsSampleWithFileTransfer"

    server {
        interface: "com.sdv.google.diagnostics.file_transfer.FileTransferService"
    }

    client {
        interface: "com.sdv.google.diagnostics.DiagnosticsManagerService"
    }
}

sdv_service_bundle {
    name: "DiagnosticsGenerationTestWithManyServersAndHandlers"

    server {
        interface: "com.sdv.google.diagnostics.data_item.DataItemService"
    }
    server {
        interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.io_control.IoControlService"
    }
    server {
        interface: "com.sdv.google.diagnostics.fault.FaultListenerService"
    }
    server {
        interface: "com.sdv.google.diagnostics.file_transfer.FileTransferService"
    }
    server {
        interface: "com.sdv.google.diagnostics.security_access.SecurityAccessService"
    }
    server {
        interface: "com.sdv.google.diagnostics.authentication.AuthenticationService"
    }

    diagnostics_declaration {
        data_item { id: "one" }
        data_item { id: "two" }
        data_item { id: "three" }
        data_item { id: "four" }
        data_item { id: "five" }
        data_item { id: "six" }
        data_item { id: "seven" }
        data_item { id: "eight" }
        routine { id: "one" }
        routine { id: "two" }
        routine { id: "three" }
        routine { id: "four" }
        routine { id: "five" }
        routine { id: "six" }
        routine { id: "seven" }
        routine { id: "eight" }
        io_control { id: "one" }
        io_control { id: "two" }
        io_control { id: "three" }
        io_control { id: "four" }
        io_control { id: "five" }
        io_control { id: "six" }
        io_control { id: "seven" }
        io_control { id: "eight" }
        event { id: "one" fault_listener_mask: 0x1 }
        event { id: "two" fault_listener_mask: 0x1 }
        event { id: "three" fault_listener_mask: 0x1 }
        event { id: "four" fault_listener_mask: 0x1 }
        event { id: "five" fault_listener_mask: 0x1 }
        event { id: "six" fault_listener_mask: 0x1 }
        event { id: "seven" fault_listener_mask: 0x1 }
        event { id: "eight" fault_listener_mask: 0x1 }
    }
}

sdv_service_bundle {
    name: "DiagnosticsGenerationTestForEventNameSupport"

    server {
        interface: "com.sdv.google.diagnostics.fault.FaultListenerService"
    }

    diagnostics_declaration {
        event {
            id: "event_with_dot.with_hyphen-with_UPPERCASE"
            fault_listener_mask: 0x3
        }
    }
}
