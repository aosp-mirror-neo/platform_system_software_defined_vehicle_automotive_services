# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.sample.diagnostics"

sdv_service_bundle {
    name: "DiagnosticsProvider1"

    server {
        interface: "sdv.diagnostics.data_item.DataItemService"
    }
    server {
        interface: "sdv.diagnostics.routine_control.RoutineControlService"
    }
    server {
        interface: "sdv.diagnostics.io_control.IoControlService"
    }

    diagnostics_declaration {
        event {
            id: "lowpressure"
            extended_data_message_name: "LowPressureData"
        }

        data_item {
            id: "pressure"
            message_name: "Pressure"
        }

        data_item {
            id: "low_pressure_threshold"
            message_name: "Pressure"
            is_writable: true
        }

        routine {
            id: "pressurization"
            start {
                request: "Pressure"
            }
        }

        io_control {
            id: "pressure"
            message_name: "Pressure"
        }
    }
}

sdv_service_bundle {
    name: "DiagnosticsProvider2"

    diagnostics_declaration {
        event {
            id: "overheating"
            extended_data_message_name: "OverheatingData"
        }
    }
}