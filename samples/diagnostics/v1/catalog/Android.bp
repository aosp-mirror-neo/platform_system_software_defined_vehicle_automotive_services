// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiagnostics_v1_sample_catalog",
    crate_name: "diagnostics_v1_sample_catalog",
    protos: [
        "*.proto",
    ],
    source_stem: "diagnostics_v1_sample_catalog",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_proto_rs",
        "libdiagnostics_v1_api",
    ],
    vendor_available: true,
    product_available: true,
}

genrule {
    name: "generate_from_vsidl_for_diagnostics_sample_with_data_item",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_vsidl_v1_protos",
        ":diagnostics_v1_catalog_files",
        "*.*",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/core_services/vsidl/protos" +
        " --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/v1/catalog" +
        " --output-path $(genDir) " +
        " --dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1" +
        " --service-bundle-name DiagnosticsSampleWithDataItem",
    out: [
        "diagnostics-config.binpb",
        "vsidl-config.binpb",
    ],
}

genrule {
    name: "generate_from_vsidl_for_diagnostics_sample_with_event",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_vsidl_v1_protos",
        ":diagnostics_v1_catalog_files",
        "*.*",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/core_services/vsidl/protos" +
        " --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/v1/catalog" +
        " --output-path $(genDir) " +
        " --dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1" +
        " --service-bundle-name DiagnosticsSampleWithEvent",
    out: [
        "diagnostics-config.binpb",
        "vsidl-config.binpb",
    ],
}
