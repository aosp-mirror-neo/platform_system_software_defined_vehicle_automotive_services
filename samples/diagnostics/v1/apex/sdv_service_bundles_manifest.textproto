sdv_service_bundle_metadata {
    # This name must match the VSIDL's Bundle Name
    name: "DiagnosticsSampleWithDataItem"
    version_number: 1
    version_name: "1"

    # Reference the manifest itself to mark this as a config-only declaration.
    native_library_path: "lib64/liboem_diagnostics_sample_with_data_item.so"

    orchestration_config_path: "etc/data_item/orchestration.textproto"

    access_control_list_policy_path: "etc/data_item/acl.textproto"

    vsidl_schemas_path: "etc/vsidl_provider/DiagnosticsSampleWithDataItem-vsidl-config.binpb"
    diagnostics_config_path: "etc/vsidl_provider/DiagnosticsSampleWithDataItem-diag-config.binpb"
}
