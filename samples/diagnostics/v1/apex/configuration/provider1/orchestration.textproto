# proto-message: ServiceBundleConfig

# Service bundle FQIN with instance.
package_name: "com.sdv.oem.sample.diagnostics"
service_bundle_name: "DiagnosticsProvider1"
instance: "default"

## Group of service bundles to be started on boot.
group_mapping { group: "diagnostics_provider1_auto_start" instance: "default" }
