# ACL policies for service units of bundle with data item.

acls { name: "DiagnosticsAgent" include: "com.sdv.oem.diagnostics.DiagnosticsAgent" }

service_units {
  name: "com-sdv-google-diagnostics-event-event-overheating"
  acl_names: "DiagnosticsAgent"
}
