# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for service units of bundle with event.

acls {
    name: "DiagnosticsAgentAvailable"
    include: "com.sdv.oem.diagnostics.DiagnosticsAgent"
}

service_units {
    name: "overheating-event"
    acl_names: "DiagnosticsAgentAvailable"
}
service_units {
    name: "overheating-fault"
    acl_names: "DiagnosticsAgentAvailable"
}
service_units {
    name: "operation-cycles"
    acl_names: "DiagnosticsAgentAvailable"
}
service_units {
    name: "enable-conditions"
    acl_names: "DiagnosticsAgentAvailable"
}
