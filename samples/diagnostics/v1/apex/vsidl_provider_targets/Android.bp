    filename: "DiagnosticsGenerationTestForEventNameSupport-vsidl-config.binpb",
    sub_dir: "vsidl_provider",
    src: ":generate_vsidl_files_single_bundle_com.sdv.oem.sample.diagnostics.DiagnosticsGenerationTestForEventNameSupport{vsidl-config.binpb}",
    installable: false,
}

genrule {
    name: "generate_vsidl_files_single_bundle_com.sdv.oem.sample.diagnostics.DiagnosticsGenerationTestForEventNameSupport",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libdiagnostics_v1_sample_catalog_files",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/core_services/vsidl/protos" +
        " --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/v1/catalog" +
        " --output-path $(genDir) " +
        " --dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1" +
        " --package-name com.sdv.oem.sample.diagnostics" +
        " --service-bundle-name DiagnosticsGenerationTestForEventNameSupport",
    out: [
        "diagnostics-config.binpb",
        "vsidl-config.binpb",
    ],
}

// Pre-compiled file with VSIDL schemas for com.sdv.oem.diagnostics.DiagnosticsAgent.
//
// DEPRECATED: you should use "com.sdv.oem.diagnostics-vsidl-config.binpb" prebuilt_etc instead
// Usage: add the following line to com.sdv.oem.diagnostics.DiagnosticsAgent manifest declaration:
// + vsidl_schemas_path: "etc/vsidl_provider/DiagnosticsAgent-vsidl-config.binpb"
prebuilt_etc {
    name: "com.sdv.oem.diagnostics.DiagnosticsAgent-vsidl-config.binpb",
    filename: "DiagnosticsAgent-vsidl-config.binpb",
    sub_dir: "vsidl_provider",
    src: ":generate_vsidl_files_single_bundle_com.sdv.oem.diagnostics.DiagnosticsAgent{vsidl-config.binpb}",
    installable: false,
}

genrule {
    name: "generate_vsidl_files_single_bundle_com.sdv.oem.diagnostics.DiagnosticsAgent",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libdiagnostics_v1_sample_catalog_files",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/core_services/vsidl/protos" +
        " --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/v1/catalog" +
        " --output-path $(genDir) " +
        " --dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1" +
        " --package-name com.sdv.oem.diagnostics" +
        " --service-bundle-name DiagnosticsAgent",
    out: [
        "vsidl-config.binpb",
    ],
}

// Pre-compiled file with VSIDL schemas for libdiagnostics_v1_sample_catalog_files catalog.
//
// Usage: add this target to the VM image.
//
// This will be used by VSIDL provider as a fallback if the data can't be read from
// one of the per-Bundle files.
prebuilt_etc {
    name: "libdiagnostics_v1_sample_catalog_files-vsidl-config.binpb",
    sub_dir: "vsidl_v1/vsidl_config",
    src: ":generate_vsidl_files_libdiagnostics_v1_sample_catalog_files{vsidl-config.binpb}",
}

genrule {
    name: "generate_vsidl_files_libdiagnostics_v1_sample_catalog_files",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":libdiagnostics_v1_sample_catalog_files",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/core_services/vsidl/protos" +
        " --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/v1/catalog" +
        " --dependency-catalog-path system/software_defined_vehicle/automotive_services/diagnostics/vsidl/v1" +
        " --output-path $(genDir) ",
    out: [
        "vsidl-config.binpb",
    ],
}
