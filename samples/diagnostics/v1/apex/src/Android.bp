// Copyright 2024 Google LLC

rust_defaults {
    name: "diag_sample@defaults",
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libdiagnostics_v1_sample_catalog",
        "libdiagnostics_v1_api",
        "libsdv_lifecycle_client_rust",
        "libtokio",
        "libsdv_rs",
        "libsdv_comms_rs",
        "libtokio_util",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    product_specific: true,
    // Allows the library to be available inside the APEX.
    apex_available: [
        "com.sdv.oem.sample.diagnostics",
    ],
}

rust_ffi_shared {
    name: "liboem_diagnostics_sample_with_data_item",
    crate_name: "oem_diagnostics_sample_with_data_item",
    srcs: ["data_item_sample.rs"],
    ld_flags: ["-Wl,--no-as-needed"],
    rustlibs: [
        "libsdv_mw_rs_com_sdv_oem_sample_diagnostics_diagnostics_sample_with_data_item",
        // The rest of the dependencies are unused, included here only to verify their
        // availability for updatable APEXes.
        "libcom_sdv_google_diagnostics_data_item_data_item_service_rpc_rs",
        "libcom_sdv_google_diagnostics_routine_control_routine_control_service_rpc_rs",
        "libcom_sdv_google_diagnostics_io_control_io_control_service_rpc_rs",
        "libcom_sdv_google_diagnostics_fault_fault_listener_service_rpc_rs",
        "libcom_sdv_google_diagnostics_diagnostics_manager_service_rpc_rs",
        "libcom_sdv_google_diagnostics_ecu_reset_ecu_reset_service_rpc_rs",
        "libcom_sdv_google_diagnostics_security_access_security_access_service_rpc_rs",
        "libcom_sdv_google_diagnostics_authentication_authentication_service_rpc_rs",
        "libcom_sdv_google_diagnostics_file_transfer_file_transfer_service_rpc_rs",
    ],
    defaults: ["diag_sample@defaults"],
    min_sdk_version: "35",
}

rust_ffi_shared {
    name: "liboem_diagnostics_sample_with_event",
    crate_name: "oem_diagnostics_sample_with_event",
    srcs: ["event_sample.rs"],
    ld_flags: ["-Wl,--no-as-needed"],
    defaults: ["diag_sample@defaults"],
    rustlibs: [
        "libsdv_mw_rs_com_sdv_oem_sample_diagnostics_diagnostics_sample_with_event",
    ],
    min_sdk_version: "35",
}
