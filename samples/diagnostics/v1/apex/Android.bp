// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

apex {
    name: "com.sdv.oem.sample.diagnostics",
    manifest: "apex_manifest.json",
    key: "com.sdv.oem.sample.diagnostics.key",
    certificate: ":com.sdv.oem.sample.diagnostics.certificate",
    file_contexts: "file_contexts",
    native_shared_libs: [
        "liboem_diagnostics_sample_with_data_item",
        "liboem_diagnostics_sample_with_event",
    ],
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.sdv.oem.sample.diagnostics.manifest",
        // ACL Policy
        "com.sdv.oem.sample.diagnostics.data_item.acl_policy",
        // Orchestration config
        "com.sdv.oem.sample.diagnostics.data_item.orchestration",
        // ACL Policy
        "com.sdv.oem.sample.diagnostics.event.acl_policy",
        // Orchestration config
        "com.sdv.oem.sample.diagnostics.event.orchestration",
        // Start: VSIDL provider precompiled files
        "com.sdv.oem.sample.diagnostics.DiagnosticsSampleWithDataItem-vsidl-config.binpb",
        "com.sdv.oem.sample.diagnostics.DiagnosticsSampleWithEvent-vsidl-config.binpb",
        "com.sdv.oem.sample.diagnostics.DiagnosticsProvider1-vsidl-config.binpb",
        "com.sdv.oem.sample.diagnostics.DiagnosticsSampleWithDataItem-diag-config.binpb",
        "com.sdv.oem.sample.diagnostics.DiagnosticsSampleWithEvent-diag-config.binpb",
        "com.sdv.oem.sample.diagnostics.DiagnosticsProvider1-diag-config.binpb",
        // End: VSIDL provider precompiled files
        // Linker configuration to enable loading library from apex.
        "com.sdv.oem.sample.diagnostics.linker_config",
        // ACL Policy
        "com.sdv.oem.sample.diagnostics.provider1.acl_policy",
        // ACL Policy
        "com.sdv.oem.sample.diagnostics.sample_bundle.acl_policy",
    ],
    product_specific: true,
    min_sdk_version: "35",
    updatable: true,
}

apex_key {
    name: "com.sdv.oem.sample.diagnostics.key",
    public_key: "com.sdv.oem.sample.diagnostics.avbpubkey",
    private_key: "com.sdv.oem.sample.diagnostics.pem",
}

android_app_certificate {
    name: "com.sdv.oem.sample.diagnostics.certificate",
    certificate: "com.sdv.oem.sample.diagnostics",
}

// SDV manifest file.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.data_item.acl_policy",
    src: "configuration/bundle_with_data_item/acl.textproto",
    sub_dir: "data_item",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.event.acl_policy",
    src: "configuration/bundle_with_event/acl.textproto",
    sub_dir: "event",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.provider1.acl_policy",
    src: "configuration/provider1/acl.textproto",
    sub_dir: "provider1",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.sample_bundle.acl_policy",
    src: "configuration/sample_bundle/acl.textproto",
    sub_dir: "sample_bundle",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.data_item.orchestration",
    src: "configuration/bundle_with_data_item/orchestration.textproto",
    sub_dir: "data_item",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.sdv.oem.sample.diagnostics.event.orchestration",
    src: "configuration/bundle_with_event/orchestration.textproto",
    sub_dir: "event",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.sdv.oem.sample.diagnostics.linker_config",
    src: "linker.config.json",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The linker configuration is used only inside of an apex.
    installable: false,
}
