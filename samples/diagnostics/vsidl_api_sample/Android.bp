package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "diag_samples@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    crate_name: "diag_samples",
    rustlibs: [
        "libsdvgenerated_rpc_data_item",
        "libdiagnostics_api_sample",
        "libdiagnostics_api",
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libsdv_log_rust",
    ],
    apex_available: ["//apex_available:platform"],
    vendor: true,
}

rust_binary {
    name: "diag_vsidl_service_sample",
    defaults: ["diag_samples@rust_defaults"],
    srcs: ["src/service.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libsdvgenerated_diagnostics_provider_service",
        "libsdvmiddleware_rpc",
    ],
}

rust_binary {
    name: "diag_vsidl_manager_sample",
    defaults: ["diag_samples@rust_defaults"],
    srcs: ["src/manager.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libsdvgenerated_diagnostics_manager_service",
    ],
}
