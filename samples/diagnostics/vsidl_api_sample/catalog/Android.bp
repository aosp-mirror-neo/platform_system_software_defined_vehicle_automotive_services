package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiagnostics_sample_catalog",
    crate_name: "diagnostics_sample_catalog",
    protos: [
        "**/*.proto",
        ":sdv_vsidl_protos",
    ],
    source_stem: "diagnostics_sample_catalog",
    proto_flags: [
        "-I external/protobuf/src",
        "-I system/software_defined_vehicle/core_services/vsidl/protos",
    ],
    host_supported: true,
    vendor: true,
}

genrule {
    name: "libdiagnostics_sample_catalog-runtime",
    tools: ["vsidl_code_generator"],
    srcs: [
        "*",
        ":sdv_vsidl_protos",
        ":libdiagnostics_protos_with_bp_file",
    ],
    cmd: "$(location vsidl_code_generator) --vsidl-path system/software_defined_vehicle/core_services/vsidl/protos/ --catalog-path system/software_defined_vehicle/automotive_services/samples/diagnostics/vsidl_api_sample/catalog/ --output-path $(genDir) --variant runtime-config --dependency-paths system/software_defined_vehicle/automotive_services/diagnostics/vsidl",
    out: [
        "vsidl-config.binpb",
        "diagnostics-config.binpb",
    ],
}

prebuilt_etc {
    name: "libdiagnostics_sample_catalog-vsidl-config.binpb",
    sub_dir: "vsidl/vsidl_config",
    src: ":libdiagnostics_sample_catalog-runtime{vsidl-config.binpb}",
}

prebuilt_etc {
    name: "libdiagnostics_sample_catalog-diagnostics-config.binpb",
    sub_dir: "vsidl/diagnostics_config",
    src: ":libdiagnostics_sample_catalog-runtime{diagnostics-config.binpb}",
}
