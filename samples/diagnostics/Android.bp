package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "diag_service_sample",
    srcs: ["src/service.rs"],
    prefer_rlib: true,
    rustlibs: [
        "android.sdv.diagnostics-rust",
        "android.sdv.diagnostics.platform-rust",
        "libanyhow",
        "libclap",
        "liblibc",
        "libtokio",
        "libbinder_tokio_rs",
        "liblog_rust",
        "librpcbinder_rs",
        "libsdv_log_rust",
        "libsdv_sd_rs",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
}

rust_binary {
    name: "diag_manager_sample",
    srcs: ["src/manager/manager.rs"],
    prefer_rlib: true,
    rustlibs: [
        "android.sdv.diagnostics-rust",
        "android.sdv.diagnostics.platform-rust",
        "libanyhow",
        "libclap",
        "liblibc",
        "libtokio",
        "libbinder_tokio_rs",
        "liblog_rust",
        "librpcbinder_rs",
        "libsdv_log_rust",
        "libsdv_sd_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    apex_available: [
        "//apex_available:platform",
    ],

}
