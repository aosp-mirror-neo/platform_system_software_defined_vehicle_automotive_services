package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "diag_samples@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    crate_name: "diag_samples",
    rustlibs: [
        "libsdvgenerated_rpc_data_item",
        "libdiagnostics_api",
        "libprotobuf",
        "libanyhow",
        "liblog_rust",
        "libsdv_log_rust",
        "libprotobuf",
        "libsdvmiddleware_rpc",
    ],
    apex_available: ["//apex_available:platform"],
    vendor: true,
}

rust_binary {
    name: "diag_provider1_sample",
    defaults: ["diag_samples@rust_defaults"],
    srcs: ["src/service1.rs"],
    rustlibs: [
        "libsdvgenerated_diagnostics_provider_service1",
        "libdiagnostics_sample_catalog",
        "libsdv_middleware_extension_diagnostics",
    ],
}

rust_binary {
    name: "diag_provider2_sample",
    defaults: ["diag_samples@rust_defaults"],
    srcs: ["src/service2.rs"],
    rustlibs: [
        "libsdvgenerated_diagnostics_provider_service2",
        "libdiagnostics_sample_catalog",
        "libsdv_middleware_extension_diagnostics",
    ],
}

rust_binary {
    name: "diag_manager_sample",
    defaults: ["diag_samples@rust_defaults"],
    srcs: ["src/manager.rs"],
    rustlibs: [
        "libsdv_uds_serde",
        "libsdvgenerated_diagnostics_manager_service",
        "libsdv_config_provider",
        "libsdv_middleware_pubsub",
    ],
}
