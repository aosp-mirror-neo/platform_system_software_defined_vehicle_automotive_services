package {
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libdiagnostics_update_sample_catalog",
    crate_name: "diagnostics_update_sample_catalog",
    protos: [
        "*.proto",
    ],
    source_stem: "diagnostics_update_sample_catalog",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_stdlib_proto_rs",
        "libdiagnostics_v1_api",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}
