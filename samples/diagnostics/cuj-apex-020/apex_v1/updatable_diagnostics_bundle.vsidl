# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.google.sample.diagnostics_update"

sdv_service_bundle {
    name: "UpdatableDiagnosticsBundle"
    server {
        interface: "com.sdv.google.diagnostics.routine_control.RoutineControlService"
        service_unit_name: "tire-pressurization-routine"
    }

    diagnostics_declaration {
        routine {
            id: "tire_pressurization"
            start {
                response: "TirePressureSimple"
            }
        }
    }
}