# proto-file: //system/software_defined_vehicle/core_services/service_bundles_registry/proto/sdv_service_bundles_manifest.proto
# proto-message: SdvServiceBundleManifestEntry

# SDV service bundle metadata definition with mandatory fields.
sdv_service_bundle_metadata {
  # Service bundle name.
  name: "UpdatableDiagnosticsBundle"
  # Service bundle integer version.
  version_number: 1
  # Service bundle version as a string.
  version_name: "1"
  # Service bundle library path.
  native_library_path: "lib64/libupdatable_diagnostics_bundle.so"

  access_control_list_policy_path: "etc/acl/acl_policy.textproto"

  diagnostics_config_path: "etc/vsidl_provider/UpdatableDiagnosticsBundle-diag-config.binpb"
  vsidl_schemas_path: "etc/vsidl_provider/UpdatableDiagnosticsBundle-vsidl-config.binpb"
}