// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

apex {
    name: "com.sdv.google.sample.diagnostics_update",
    key: "com.sdv.google.sample.diagnostics_update.key",
    certificate: ":com.sdv.google.sample.diagnostics_update.certificate",
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    prebuilts: [
        "com.sdv.google.sample.diagnostics_update.acl.textproto",
        "com.sdv.google.sample.diagnostics_update.linker_config_file",
        "com.sdv.google.sample.diagnostics_update.updatable_bundle_manifest",
        "com.sdv.google.sample.diagnostics_update.UpdatableDiagnosticsBundle-diag-config.binpb",
        "com.sdv.google.sample.diagnostics_update.UpdatableDiagnosticsBundle-vsidl-config.binpb",
    ],
    native_shared_libs: [
        "libupdatable_diagnostics_bundle",
    ],
    updatable: true,
    product_specific: true,
    min_sdk_version: "35",
}

prebuilt_etc {
    name: "com.sdv.google.sample.diagnostics_update.acl.textproto",
    src: "acl.textproto",
    filename: "acl_policy.textproto",
    sub_dir: "acl",
    installable: false,
}

prebuilt_etc {
    name: "com.sdv.google.sample.diagnostics_update.updatable_bundle_manifest",
    src: "updatable_bundle_manifest.textproto",
    // filename needs to be the one defined below. One bundle manifest per apex file, containing
    // a bundle_metadata for each bundle in the apex
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

filegroup {
    name: "cuj_apex_020_apex_v1_catalog",
    srcs: ["**/*"],
}
