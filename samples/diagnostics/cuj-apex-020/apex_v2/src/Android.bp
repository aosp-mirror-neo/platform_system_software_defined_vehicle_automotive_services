// Copyright 2025 Google LLC
rust_ffi_shared {
    name: "libupdatable_diagnostics_bundle_v2",
    srcs: ["updatable_diagnostics_bundle.rs"],
    crate_name: "updatable_diagnostics_bundle_v2",
    rustlibs: [
        "libsdv_rs",
        "libsdv_log_rust",
        "libanyhow",
        "libprotobuf",
        "liblog_rust",
        "libsdv_mw_rs_com_sdv_google_sample_diagnostics_update_updatable_diagnostics_bundle_v2",
        "libdiagnostics_update_sample_catalog",
        // Tokio coroutines,async.
        "libtokio",
        "libtokio_util",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    // Allows the library to be available inside APEX.
    apex_available: [
        "com.sdv.google.sample.diagnostics_update",
    ],
    // Service bundle package is packed into /product apexes.
    product_specific: true,
    min_sdk_version: "35",
}
