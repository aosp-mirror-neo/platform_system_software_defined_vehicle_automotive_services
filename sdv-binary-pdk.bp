package {
    default_applicable_licenses: ["sdv_license"],
}

// build target to archive sample code to be shared with OEMs's partners
// with access only to the binary PDK.
genrule {
    name: "automotive_services_samples-dist",
    defaults: ["sdv@binary_pdk_dist"],
    srcs: [
        "samples/**/*",
    ],
    out: ["automotive_services_samples.zip"],
}
